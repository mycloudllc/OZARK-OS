+// Tire sensors don't pair; the vehicle service reads their broadcasts. Put
+// this one on a wheel (which also turns Bluetooth tire sensors on).
+void PhoneSettingsTab::choose_wheel(BluezQt::DevicePtr device)
+{
+    auto dialog = new Dialog(this->arbiter, true, this->arbiter.window());
+    dialog->setAttribute(Qt::WA_DeleteOnClose);
+    dialog->set_title("Which wheel is this sensor on?");
+    auto body = new QWidget();
+    auto grid = new QGridLayout(body);
+    const QString address = device->address().toUpper();
+    const QString current = this->wheels.value(address);
+    for (int i = 0; i < kWheels.size(); i++) {
+        auto button = new QPushButton(kWheels[i].second, body);
+        button->setFont(this->arbiter.forge().font(14));
+        button->setCheckable(true);
+        button->setChecked(kWheels[i].first == current);
+        const QString wheel = kWheels[i].first;
+        connect(button, &QPushButton::clicked, [this, dialog, wheel, address]{
+            VehicleClient &client = VehicleClient::instance();
+            client.call("SetConfig", {QVariantMap{{"tpms_ble", true}}});
+            client.call("AssignTpmsSensor", {wheel, address});
+            this->wheels[address] = wheel;
+            if (this->adapter)
+                if (auto device = this->adapter->deviceForAddress(address))
+                    this->update_nearby(device);
+            dialog->close();
+        });
+        grid->addWidget(button, i / 2, i % 2);
+    }
+    if (!VehicleClient::instance().running) {
+        auto note = new QLabel("The vehicle service isn't running, so this can't be saved.", body);
+        note->setWordWrap(true);
+        grid->addWidget(note, (kWheels.size() + 1) / 2, 0, 1, 2);
+    }
+    dialog->set_body(body);
+    dialog->open();
+}
+
+void PhoneSettingsTab::use_for_obd(const QString &address)
+{
+    VehicleClient::instance().call("SetConfig", {QVariantMap{{"obd_link", "elm327-bt"}, {"obd_bt_address", address}}});
+    this->obd_address = address;
+    if (this->adapter)
+        if (auto device = this->adapter->deviceForAddress(address))
+            this->update_device(device);
+}
