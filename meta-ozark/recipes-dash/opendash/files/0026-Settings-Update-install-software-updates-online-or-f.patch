+#pragma once
+
+#include <functional>
+
+#include <QMap>
+#include <QtWidgets>
+
+class Arbiter;
+class Dialog;
+class Selector;
+class Switch;
+class TextEntry;
+
+// Settings > Update: the radio's version, and installing a newer one from the
+// update address (online) or a USB drive. Everything goes through the
+// ozark-update command (meta-ozark ozark-update): it installs into the system
+// slot that isn't running, and the radio restarts into it.
+class UpdateSettingsTab : public QWidget {
+    Q_OBJECT
+
+   public:
+    UpdateSettingsTab(Arbiter &arbiter, QWidget *parent = nullptr);
+
+   protected:
+    void showEvent(QShowEvent *event) override;
+    void hideEvent(QHideEvent *event) override;
+
+   private:
+    QWidget *settings_widget();
+    QWidget *row(const QString &label, QWidget *control, bool stretch = false);
+    QLabel *heading(const QString &text);
+    QPushButton *button(const QString &text, std::function<void()> clicked);
+
+    // Runs ozark-update; line(text) for each line it prints as it goes,
+    // done(ok, message) at the end with stderr's last line on failure
+    void run(const QStringList &args, std::function<void(const QString &)> line,
+             std::function<void(bool, const QString &)> done);
+    // A long job (check, download, install): progress bar, buttons off
+    void job(const QStringList &args, std::function<void(bool, const QString &)> done);
+    void refresh();
+    void show_status(const QMap<QString, QString> &status);
+    void set_busy(bool busy);
+    void report(bool ok, const QString &message);
+
+    void check();
+    void download_and_install();
+    void install(const QString &file);
+    void find_usb();
+    void restart();
+
+    Arbiter &arbiter;
+    QTimer *timer;
+    QScrollArea *scroll;
+    bool busy = false;
+    bool filled = false;
+    bool loading = false;
+    QMap<QString, QString> status;
+
+    QLabel *version;
+    QLabel *state;
+    QLabel *step;
+    QProgressBar *progress;
+    QLabel *result;
+    QPushButton *restart_button;
+    Dialog *restart_dialog;
+    QLabel *restart_question;
+
+    TextEntry *feed;
+    Switch *auto_check;
+    QLabel *available;
+    QLabel *notes;
+    QPushButton *install_online;
+
+    Selector *usb_files;
+    QMap<QString, QString> usb_paths;  // Selector text -> file
+    QWidget *usb_row;
+    QPushButton *install_usb;
+
+    QList<QPushButton *> buttons;
+};
