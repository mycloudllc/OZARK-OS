@@ -111,8 +113,20 @@ Session::Layout::Fullscreen::Fullscreen(QSettings &settings, Arbiter &arbiter)
     this->curr_toggler = this->togglers_.value(settings.value("Layout/Fullscreen/toggler", 0).toInt());
 }
 
+namespace {
+// Pixel sizes (icons, switches, stylesheet px, dialogs) follow the screen's
+// DPI the way point-sized text does, so the two stay in proportion whatever
+// QT_FONT_DPI is set to. 96 DPI is 1x.
+double screen_scale()
+{
+    if (QScreen *screen = QGuiApplication::primaryScreen())
+        return std::max(1.0, screen->logicalDotsPerInch() / 96.0);
+    return 1.0;
+}
+}  // namespace
+
 Session::Layout::Layout(QSettings &settings, Arbiter &arbiter)
-    : scale(1.0)
+    : scale(screen_scale())
     , bar_scale(settings.value("Layout/scale", 1.0).toDouble())
     , control_bar(settings, arbiter)
     , openauto_page(new OpenAutoPage(arbiter))
@@ -311,7 +325,8 @@ void Session::Forge::iconize(QString name, QString alt_name, QAbstractButton *bu
 
 void Session::Forge::iconize(QIcon &icon, QAbstractButton *button, uint8_t size) const
 {
-    auto scaled = size * this->scale_;
+    // Icons follow the screen scale (and the bar scale inside a BarScope)
+    auto scaled = size * this->scale_ * this->arbiter_.layout().scale;
     button->setIconSize(QSize(scaled, scaled));
     button->setIcon(icon);
 }
