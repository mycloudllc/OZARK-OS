+// ---------------------------------------------------------------- phone app
+
+void PhoneSettingsTab::refresh_app_phones()
+{
+    auto call = QDBusConnection::systemBus().asyncCall(
+        QDBusMessage::createMethodCall("org.ozark.Remote1", "/org/ozark/Remote1", "org.ozark.Remote1", "ListClients"), 5000);
+    auto watch = new QDBusPendingCallWatcher(call, this);
+    connect(watch, &QDBusPendingCallWatcher::finished, this, [this](QDBusPendingCallWatcher *w) {
+        w->deleteLater();
+        while (QLayoutItem *item = this->app_list->takeAt(0)) {
+            if (item->widget())
+                item->widget()->deleteLater();
+            delete item;
+        }
+        if (w->isError()) {
+            this->app_hint->setText("The remote control service isn't running.");
+            return;
+        }
+        const QVariantMap clients = VehicleClient::unwrap(w->reply().arguments().value(0)).toMap();
+        this->app_hint->setText(clients.isEmpty()
+            ? "Control the radio from your phone with the Ozark Remote app, over Bluetooth or the radio's Wi-Fi. "
+              "The app asks for a code that appears on this screen."
+            : "These phones can control the radio with the Ozark Remote app.");
+        for (const QVariant &v : clients) {
+            const QVariantMap c = v.toMap();
+            auto row = new QFrame();
+            row->setProperty("md", "card");
+            auto layout = new QHBoxLayout(row);
+            layout->setContentsMargins(12, 6, 12, 6);
+            auto icon = new QPushButton(row);
+            icon->setFlat(true);
+            icon->setFocusPolicy(Qt::NoFocus);
+            icon->setAttribute(Qt::WA_TransparentForMouseEvents);
+            this->arbiter.forge().iconize("smartphone", icon, 28);
+            layout->addWidget(icon);
+            auto text = new QVBoxLayout();
+            auto name = new QLabel(c.value("name").toString(), row);
+            name->setFont(this->arbiter.forge().font(14));
+            text->addWidget(name);
+            const QDateTime seen = QDateTime::fromString(c.value("last_seen").toString(), Qt::ISODate).toLocalTime();
+            auto state = new QLabel(c.value("connected").toBool()
+                                        ? QString("Connected now")
+                                        : QString("Last used %1").arg(QLocale().toString(seen, QLocale::ShortFormat)), row);
+            state->setProperty("muted", true);
+            state->setFont(this->arbiter.forge().font(11));
+            text->addWidget(state);
+            layout->addLayout(text, 1);
+            auto remove = new QPushButton("remove", row);
+            remove->setFont(this->arbiter.forge().font(14));
+            remove->setFlat(true);
+            const QString id = c.value("id").toString();
+            connect(remove, &QPushButton::clicked, this, [id] {
+                QDBusConnection::systemBus().asyncCall(QDBusMessage::createMethodCall(
+                    "org.ozark.Remote1", "/org/ozark/Remote1", "org.ozark.Remote1", "RevokeClient") << id);
+            });
+            layout->addWidget(remove);
+            this->app_list->addWidget(row);
+        }
+    });
+}
diff --git a/src/app/services/dash_remote.cpp b/src/app/services/dash_remote.cpp
