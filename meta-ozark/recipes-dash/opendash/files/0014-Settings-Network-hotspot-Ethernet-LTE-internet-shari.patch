+    TextEntry *password;
+    Selector *band;
+    TextEntry *country;
+    Switch *share;
+    QString channel;
+
+    QLabel *ethernet_state;
+    Selector *ethernet_mode;
+    QWidget *static_rows;
+    TextEntry *ethernet_address;
+    TextEntry *ethernet_gateway;
+    TextEntry *ethernet_dns;
+
+    QLabel *lte_state;
+    Switch *lte_enabled;
+    TextEntry *apn;
+    TextEntry *pin;
+
+    QLabel *internet;
+    QLabel *result;
+    QList<QPushButton *> buttons;
+};
