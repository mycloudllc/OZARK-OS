From: Ozark <ozark@localhost>
Date: Mon, 16 Nov 2026 23:17:02 -0600
Subject: [PATCH] Material 3 look: colour scheme from the theme colour, M3
 stylesheets, switch, cards, segmented buttons and chips; Diagnostics, Media,
 Android Auto, Phone and Equalizer pages

---
 assets/stylesheets/dark.qss        | 380 +++++++++++++++++++---------
 assets/stylesheets/light.qss       | 386 +++++++++++++++++++----------
 include/app/md3.hpp                |  31 +++
 include/app/pages/vehicle.hpp      |  16 +-
 include/app/session.hpp            |   6 +
 include/app/widgets/switch.hpp     |  32 ++-
 src/app/md3.cpp                    | 148 +++++++++++
 src/app/pages/equalizer.cpp        |  13 +-
 src/app/pages/media.cpp            |  36 ++-
 src/app/pages/network_settings.cpp |   2 +-
 src/app/pages/openauto.cpp         |  28 ++-
 src/app/pages/phone.cpp            |   3 +
 src/app/pages/update_settings.cpp  |   7 +-
 src/app/pages/vehicle.cpp          | 281 +++++++++++++++------
 src/app/session.cpp                |  22 +-
 src/app/widgets/now_playing.cpp    |   9 +-
 src/app/widgets/osd.cpp            |  20 +-
 src/app/widgets/switch.cpp         |  57 +++--
 src/app/widgets/tuner.cpp          |   5 +
 19 files changed, 1079 insertions(+), 403 deletions(-)
 create mode 100644 include/app/md3.hpp
 create mode 100644 src/app/md3.cpp

diff --git a/assets/stylesheets/dark.qss b/assets/stylesheets/dark.qss
index 5a5bef7..b676410 100644
--- a/assets/stylesheets/dark.qss
+++ b/assets/stylesheets/dark.qss
@@ -1,6 +1,10 @@
+/* Material 3, with colours from the theme colour: @md-<role> is filled in at
+   run time from a scheme made from it (src/app/md3.cpp), @md-<role>/<n> at n %
+   opacity (state layers). */
+
 QMainWindow,
 QMainWindow > QFrame {
-    background-color: rgb(18, 18, 18);
+    background-color: @md-surface;
 }
 
 QWidget {
@@ -8,36 +12,43 @@ QWidget {
 }
 
 QLabel {
-    color: rgb(255, 255, 255);
+    color: @md-on-surface;
 }
 
 QLabel:disabled {
-    color: rgba(255, 255, 255, 128);
+    color: @md-on-surface/38;
 }
 
 /* Secondary text (album, credits): set the "muted" property on a label */
 QLabel[muted="true"] {
-    color: rgba(255, 255, 255, 140);
+    color: @md-on-surface-variant;
 }
 
+/* Primary tabs: a 3px indicator under the selected one */
 QTabWidget::pane {
     background-color: transparent;
     border: none;
-    border-top: 2px solid rgb(66, 66, 66);
+    border-top: 1px solid @md-outline-variant;
 }
 
 QTabBar::tab {
     background-color: transparent;
-    margin-right: 10px;
-    color: rgba(255, 255, 255, 179);
+    margin-right: 8px;
+    color: @md-on-surface-variant;
     margin-top: 2px;
-    padding: 4px 10px;
-    border-bottom: 2px solid transparent;
+    padding: 6px 14px;
+    border-bottom: 3px solid transparent;
+    border-top-left-radius: 3px;
+    border-top-right-radius: 3px;
+}
+
+QTabBar::tab:pressed {
+    background-color: @md-on-surface/12;
 }
 
 QTabBar::tab:selected:top {
-    color: palette(base);
-    border-bottom: 2px solid palette(base);
+    color: @md-primary;
+    border-bottom: 3px solid @md-primary;
 }
 
 QTabBar::tab:disabled {
@@ -47,70 +58,168 @@ QTabBar::tab:disabled {
     margin: 0px;
 }
 
+/* Sliders: a thick rounded track, the active part in primary, a round handle */
 QSlider {
-    height: 30px;
+    height: 36px;
 }
 
 QSlider::groove {
-    background-color: palette(alternate-base);
-    height: 5px;
-    border-radius: 2px;
+    background-color: @md-secondary-container;
+    height: 12px;
+    border-radius: 6px;
 }
 
 QSlider::groove[neutral="true"] {
-    background-color: rgba(224, 224, 224, 128);
+    background-color: @md-surface-container-highest;
 }
 
 QSlider::handle {
-    background-color: palette(base);
-    width: 25px;
-    height: 5px;
-    line-height: 26px;
-    margin-top: -10px;
-    margin-bottom: -10px;
+    background-color: @md-primary;
+    width: 24px;
+    height: 24px;
+    margin-top: -6px;
+    margin-bottom: -6px;
     border-radius: 12px;
 }
 
 QSlider::handle[neutral="true"] {
-    background-color: rgb(224, 224, 224);
+    background-color: @md-on-surface-variant;
 }
 
 QSlider::sub-page {
-    background-color: palette(base);
-    height: 5px;
-    border-radius: 2px;
+    background-color: @md-primary;
+    height: 12px;
+    border-radius: 6px;
 }
 
 QSlider::sub-page[neutral="true"] {
-    background-color: rgb(224, 224, 224);
+    background-color: @md-on-surface-variant;
 }
 
+/* Flat buttons are M3 text (and icon) buttons; the others filled tonal buttons */
 QPushButton {
-    color: rgb(255, 255, 255);
+    color: @md-primary;
     border: none;
-    padding: 8px;
-    border-radius: 8px;
+    padding: 10px 16px;
+    border-radius: 20px;
 }
 
 QPushButton:pressed {
-    background-color: rgba(255, 255, 255, 25);
+    background-color: @md-primary/12;
 }
 
 QPushButton:disabled {
-    color: rgba(255, 255, 255, 128);
+    color: @md-on-surface/38;
 }
 
 QPushButton:!flat {
-    background-color: rgb(50, 50, 50);
+    color: @md-on-secondary-container;
+    background-color: @md-secondary-container;
+}
+
+QPushButton:!flat:pressed {
+    background-color: @md-on-secondary-container/20;
 }
 
 QPushButton:!flat:checked {
-    color: rgb(0, 0, 0);
-    background-color: palette(base);
+    color: @md-on-primary;
+    background-color: @md-primary;
 }
 
 QPushButton:!flat:disabled {
-    background-color: rgb(33, 33, 33);
+    color: @md-on-surface/38;
+    background-color: @md-on-surface/12;
+}
+
+/* M3 button variants: md="filled" (primary), md="outlined", md="tonal" */
+QPushButton[md="filled"] {
+    color: @md-on-primary;
+    background-color: @md-primary;
+}
+
+QPushButton[md="filled"]:pressed {
+    background-color: @md-primary/88;
+}
+
+QPushButton[md="outlined"] {
+    color: @md-primary;
+    background-color: transparent;
+    border: 1px solid @md-outline;
+}
+
+QPushButton[md="tonal"] {
+    color: @md-on-secondary-container;
+    background-color: @md-secondary-container;
+}
+
+QPushButton[md]:disabled {
+    color: @md-on-surface/38;
+    background-color: @md-on-surface/12;
+    border: none;
+}
+
+/* M3 segmented buttons: segment="first" / "middle" / "last" */
+QPushButton[segment] {
+    color: @md-on-surface;
+    background-color: transparent;
+    border: 1px solid @md-outline;
+    border-radius: 0px;
+    padding: 8px 20px;
+}
+
+QPushButton[segment="first"] {
+    border-top-left-radius: 20px;
+    border-bottom-left-radius: 20px;
+}
+
+QPushButton[segment="last"] {
+    border-top-right-radius: 20px;
+    border-bottom-right-radius: 20px;
+    border-left: none;
+}
+
+QPushButton[segment="middle"] {
+    border-left: none;
+}
+
+QPushButton[segment]:checked {
+    color: @md-on-secondary-container;
+    background-color: @md-secondary-container;
+}
+
+/* M3 filter chips: md="chip" (checkable) */
+QPushButton[md="chip"] {
+    color: @md-on-surface-variant;
+    background-color: transparent;
+    border: 1px solid @md-outline;
+    border-radius: 8px;
+    padding: 8px 16px;
+}
+
+QPushButton[md="chip"]:checked {
+    color: @md-on-secondary-container;
+    background-color: @md-secondary-container;
+    border: 1px solid @md-secondary-container;
+}
+
+QPushButton[md="chip"]:pressed {
+    background-color: @md-on-surface/12;
+}
+
+/* M3 cards: md="card" (and "card-high") on a QFrame */
+QFrame[md="card"] {
+    background-color: @md-surface-container-low;
+    border-radius: 24px;
+}
+
+QFrame[md="card-high"] {
+    background-color: @md-surface-container-high;
+    border-radius: 24px;
+}
+
+QFrame[md="card"] QListWidget,
+QFrame[md="card-high"] QListWidget {
+    background-color: transparent;
 }
 
 QPushButton#FullscreenBar {
@@ -118,34 +227,57 @@ QPushButton#FullscreenBar {
     margin: 2px;
 }
 
+/* Navigation rail: a pill behind the selected page's icon */
+#NavRail {
+    background-color: @md-surface-container;
+}
+
+#NavRail QPushButton {
+    border-radius: 16px;
+    margin: 4px 8px;
+    padding: 6px;
+}
+
+#NavRail QPushButton:checked {
+    background-color: @md-secondary-container;
+}
+
+#NavRail QPushButton:pressed {
+    background-color: @md-on-surface/12;
+}
+
 QFrame[frameShape="4"][frameShadow="16"],
 QFrame[frameShape="5"][frameShadow="16"] {
-    color: rgba(255, 255, 255, 66);
+    color: @md-outline-variant;
 }
 
 QListWidget {
-    background-color: rgb(46, 46, 46); 
-    color: rgb(255, 255, 255);
-    border: 2px solid rgb(66, 66, 66);
+    background-color: @md-surface-container-low;
+    color: @md-on-surface;
+    border: none;
 }
 
 QListView {
-    padding: 2px;
-    border-radius: 8px;
+    padding: 4px;
+    border-radius: 12px;
 }
 
 QListView::indicator {
     border: none;
 }
 
+QListView::item {
+    padding: 4px;
+}
+
 QListView::item:selected {
-    color: rgb(0, 0, 0);
-    background-color: palette(base);
-    border-radius: 8px;
+    color: @md-on-secondary-container;
+    background-color: @md-secondary-container;
+    border-radius: 12px;
 }
 
 QListView::item:disabled {
-    color: rgba(255, 255, 255, 128);
+    color: @md-on-surface/38;
 }
 
 QGroupBox {
@@ -153,51 +285,51 @@ QGroupBox {
 }
 
 QCheckBox {
-    color: rgb(255, 255, 255);
+    color: @md-on-surface;
     background-color: transparent;
 }
 
 QRadioButton {
-    color: rgb(255, 255, 255);
+    color: @md-on-surface;
     background-color: transparent;
 }
 
 QRadioButton:disabled {
-    color: rgb(136, 136, 136);
+    color: @md-on-surface/38;
 }
 
 QCheckBox::indicator {
-    width: 22px;
-    height: 22px;
-    border: 2px solid rgb(255, 255, 255);
+    width: 18px;
+    height: 18px;
+    border: 2px solid @md-on-surface-variant;
     border-radius: 3px;
 }
 
 QRadioButton::indicator {
-    width: 19px;
-    height: 19px;
-    border: 2px solid rgb(255, 255, 255);
+    width: 18px;
+    height: 18px;
+    border: 2px solid @md-on-surface-variant;
     border-radius: 11px;
 }
 
 QRadioButton::indicator:disabled {
-    border: 2px solid rgb(136, 136, 136);
+    border: 2px solid @md-on-surface/38;
 }
 
 QCheckBox::indicator::checked {
     image: url(:/icons/dark/check.svg);
-    background-color: palette(base);
-    border: 2px solid palette(base);
+    background-color: @md-primary;
+    border: 2px solid @md-primary;
 }
 
 QRadioButton::indicator::checked {
-    background-color: qradialgradient(cx:0.5, cy:0.5, fx:0.5, fy:0.5, radius:.4, stop:.65 palette(base), stop:.75 transparent);
-    border: 2px solid palette(base);
+    background-color: qradialgradient(cx:0.5, cy:0.5, fx:0.5, fy:0.5, radius:.4, stop:.6 @md-primary, stop:.7 transparent);
+    border: 2px solid @md-primary;
 }
 
 QRadioButton::indicator::checked:disabled {
-    background-color: qradialgradient(cx:0.5, cy:0.5, fx:0.5, fy:0.5, radius:.4, stop:.65 rgb(136, 136, 136), stop:.75 transparent);
-    border: 2px solid rgb(136, 136, 136);
+    background-color: qradialgradient(cx:0.5, cy:0.5, fx:0.5, fy:0.5, radius:.4, stop:.6 @md-on-surface/38, stop:.7 transparent);
+    border: 2px solid @md-on-surface/38;
 }
 
 QScrollArea {
@@ -209,7 +341,7 @@ QScrollArea > QWidget > QWidget {
     background-color: transparent;
 }
 
-/* Material-style: a thin rounded thumb, no track, no arrow buttons */
+/* A thin rounded thumb, no track, no arrow buttons */
 QScrollBar {
     background-color: transparent;
     border: none;
@@ -226,12 +358,12 @@ QScrollBar:horizontal {
 }
 
 QScrollBar::handle {
-    background-color: rgba(255, 255, 255, 97);
+    background-color: @md-on-surface/38;
     border-radius: 3px;
 }
 
 QScrollBar::handle:pressed {
-    background-color: rgba(255, 255, 255, 153);
+    background-color: @md-on-surface/62;
 }
 
 QScrollBar::handle:vertical {
@@ -254,16 +386,26 @@ QScrollBar::sub-page {
     background: none;
 }
 
-/* Spin boxes look like text boxes; without a rule they took the palette's
-   base colour, which is the theme accent (black text on black by default) */
-QAbstractSpinBox {
+/* Filled text fields: spin boxes, drop-downs and line edits */
+QAbstractSpinBox,
+QComboBox {
     border: none;
-    border-top-left-radius: 6px;
-    border-top-right-radius: 6px;
-    padding: 6px 12px;
-    color: rgb(255, 255, 255);
-    background-color: rgb(25, 25, 25);
-    border-bottom: 1px solid rgb(66, 66, 66);
+    border-top-left-radius: 4px;
+    border-top-right-radius: 4px;
+    padding: 8px 12px;
+    color: @md-on-surface;
+    background-color: @md-surface-container-highest;
+    border-bottom: 1px solid @md-on-surface-variant;
+}
+
+QComboBox {
+    selection-background-color: transparent;
+    selection-color: @md-on-surface;
+}
+
+QAbstractSpinBox:focus,
+QComboBox:focus {
+    border-bottom: 2px solid @md-primary;
 }
 
 QAbstractSpinBox::up-button,
@@ -271,19 +413,6 @@ QAbstractSpinBox::down-button {
