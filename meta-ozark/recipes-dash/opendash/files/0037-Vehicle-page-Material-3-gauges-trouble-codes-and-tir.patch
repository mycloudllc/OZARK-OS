+#include "app/services/vehicle_client.hpp"
+
+namespace {
+const char *kService = "org.ozark.Vehicle1";
+const char *kPath = "/org/ozark/Vehicle1";
+const char *kInterface = "org.ozark.Vehicle1";
+
+QVariantMap first_map(const QDBusMessage &message)
+{
+    return VehicleClient::unwrap(message.arguments().value(0)).toMap();
+}
+}  // namespace
+
+VehicleClient &VehicleClient::instance()
+{
+    static VehicleClient client;
+    return client;
+}
+
+VehicleClient::VehicleClient()
+{
+    QDBusConnection bus = QDBusConnection::systemBus();
+    bus.connect(kService, kPath, kInterface, "StatusChanged", this, SLOT(on_status(QDBusMessage)));
+    bus.connect(kService, kPath, kInterface, "ValuesChanged", this, SLOT(on_values(QDBusMessage)));
+    bus.connect(kService, kPath, kInterface, "TiresChanged", this, SLOT(on_tires(QDBusMessage)));
+    bus.connect(kService, kPath, kInterface, "DtcsRead", this, SLOT(on_dtcs(QDBusMessage)));
+    bus.connect(kService, kPath, kInterface, "DtcsCleared", this, SLOT(on_cleared(bool, QString)));
+    bus.connect(kService, kPath, kInterface, "IlluminationChanged", this, SLOT(on_illumination(bool)));
+    bus.connect(kService, kPath, kInterface, "ConfigChanged", this, SLOT(on_config(QDBusMessage)));
+
+    // Started after Dash, or restarted: fetch everything again
+    this->watcher = new QDBusServiceWatcher(kService, bus, QDBusServiceWatcher::WatchForOwnerChange, this);
+    connect(this->watcher, &QDBusServiceWatcher::serviceOwnerChanged, this,
+            [this](const QString &, const QString &, const QString &owner) {
+                this->running = !owner.isEmpty();
+                if (this->running) {
+                    this->refresh();
+                } else {
+                    this->status.clear();
+                    this->values.clear();
+                    emit status_changed();
+                    emit values_changed();
+                }
+            });
+    this->refresh();
+}
+
+QVariant VehicleClient::unwrap(const QVariant &value)
+{
+    if (value.userType() == qMetaTypeId<QDBusVariant>())
+        return unwrap(value.value<QDBusVariant>().variant());
+    if (value.userType() == qMetaTypeId<QDBusArgument>()) {
+        const QDBusArgument arg = value.value<QDBusArgument>();
+        if (arg.currentType() == QDBusArgument::MapType) {
+            QVariantMap map;
+            arg >> map;
+            return unwrap(map);
+        }
+        if (arg.currentType() == QDBusArgument::ArrayType) {
+            const QString sig = arg.currentSignature();
+            if (sig == "as") {
+                QStringList strings;
+                arg >> strings;
+                return strings;
+            }
+            QVariantList list;
+            if (sig == "aa{sv}") {
+                arg.beginArray();
+                while (!arg.atEnd()) {
+                    QVariantMap map;
+                    arg >> map;
+                    list << unwrap(map);
+                }
+                arg.endArray();
+                return list;
+            }
+            if (sig == "ai") {
+                QList<int> ints;
+                arg >> ints;
+                for (int i : ints)
+                    list << i;
+                return list;
+            }
+            arg.beginArray();
+            while (!arg.atEnd()) {
+                QDBusVariant item;
+                arg >> item;
+                list << unwrap(item.variant());
+            }
+            arg.endArray();
+            return list;
+        }
+        return QVariant();
+    }
+    if (value.type() == QVariant::Map) {
+        QVariantMap map = value.toMap();
+        for (auto it = map.begin(); it != map.end(); ++it)
+            it.value() = unwrap(it.value());
+        return map;
+    }
+    if (value.type() == QVariant::List) {
+        QVariantList list = value.toList();
+        for (auto &item : list)
+            item = unwrap(item);
+        return list;
+    }
+    return value;
+}
+
+void VehicleClient::call(const QString &method, const QVariantList &args, std::function<void(const QVariantList &)> done)
+{
+    QDBusMessage message = QDBusMessage::createMethodCall(kService, kPath, kInterface, method);
+    message.setArguments(args);
+    auto pending = new QDBusPendingCallWatcher(QDBusConnection::systemBus().asyncCall(message), this);
+    connect(pending, &QDBusPendingCallWatcher::finished, this, [this, done](QDBusPendingCallWatcher *w) {
+        w->deleteLater();
+        const QDBusMessage reply = w->reply();
+        if (reply.type() != QDBusMessage::ReplyMessage)
+            return;
+        this->running = true;
+        if (done) {
+            QVariantList out;
+            for (const QVariant &a : reply.arguments())
+                out << unwrap(a);
+            done(out);
+        }
+    });
+}
+
+void VehicleClient::refresh()
+{
+    this->call("GetStatus", {}, [this](const QVariantList &r) {
+        this->status = r.value(0).toMap();
+        const bool on = this->status.value("illumination").toMap().value("on").toBool();
+        emit status_changed();
+        if (on != this->illumination) {
+            this->illumination = on;
+            emit illumination_changed(on);
+        }
+    });
+    this->call("GetValues", {}, [this](const QVariantList &r) {
+        this->values = r.value(0).toMap();
+        emit values_changed();
+    });
+    this->call("GetTires", {}, [this](const QVariantList &r) {
+        this->tires = r.value(0).toMap();
+        emit tires_changed();
+    });
+    this->call("GetDtcs", {}, [this](const QVariantList &r) {
+        const QVariantMap d = r.value(0).toMap();
+        if (!d.isEmpty()) {
+            this->dtcs = d;
+            emit dtcs_read(d);
+        }
+    });
+}
+
+void VehicleClient::on_status(const QDBusMessage &message)
+{
+    this->running = true;
+    this->status = first_map(message);
+    emit status_changed();
+}
+
+void VehicleClient::on_values(const QDBusMessage &message)
+{
+    this->values = first_map(message);
