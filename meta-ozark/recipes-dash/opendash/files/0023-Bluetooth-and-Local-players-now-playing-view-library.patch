+    // Shown instead of the track details when nothing is loaded ("" = track)
+    void set_message(const QString &message, const QString &hint = QString());
+    void set_playing(bool playing);
+    // Milliseconds; a zero duration hides the progress bar's times
+    void set_position(qint64 position, qint64 duration);
+    void set_seekable(bool seekable);
+
+   signals:
+    void play_pause(bool play);
+    void previous();
+    void next();
+    void seek(qint64 position);
+
+   protected:
+    void resizeEvent(QResizeEvent *event) override;
+
+   private:
+    void update_text();
+    QPushButton *control(const QString &icon, int size);
+
+    Arbiter &arbiter;
+    AlbumArt *art;
+    QLabel *source;
+    QLabel *title;
+    QLabel *artist;
+    QLabel *album;
+    QSlider *progress;
+    QLabel *elapsed;
+    QLabel *total;
+    QPushButton *play;
+    bool playing = false;
+    QString title_text, artist_text, album_text, message_text, hint_text;
+};
