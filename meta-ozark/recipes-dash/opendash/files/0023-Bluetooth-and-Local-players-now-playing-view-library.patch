+// The now-playing view of the Bluetooth and Local players: album art, title,
+// artist and album, a progress bar with times, and previous / play-pause /
+// next. Sources feed it track details and react to its signals.
+class NowPlaying : public QWidget {
+    Q_OBJECT
+
+   public:
+    NowPlaying(Arbiter &arbiter, QWidget *parent = nullptr);
+
+    void set_track(const QString &title, const QString &artist, const QString &album);
+    void set_art(const QImage &art) { this->art->set_art(art); }
