+    margin: 2px 4px 2px 4px;
 }
 
 QScrollBar::handle {
-    background-color: rgba(0, 0, 0, 64);
-    border-radius: 8px;
+    background-color: rgba(0, 0, 0, 97);
+    border-radius: 3px;
 }
 
-QScrollBar::add-line {
-    border: none;
+QScrollBar::handle:pressed {
+    background-color: rgba(0, 0, 0, 153);
+}
+
+QScrollBar::handle:vertical {
+    min-height: 32px;
+}
+
+QScrollBar::handle:horizontal {
+    min-width: 32px;
 }
 
+QScrollBar::add-line,
 QScrollBar::sub-line {
     border: none;
+    width: 0px;
+    height: 0px;
+}
+
+QScrollBar::add-page,
+QScrollBar::sub-page {
+    background: none;
 }
 
 QLineEdit {
diff --git a/include/app/window.hpp b/include/app/window.hpp
index e5795c2..5c674f2 100644
--- a/include/app/window.hpp
+++ b/include/app/window.hpp
@@ -51,7 +51,6 @@ class Dash : public QWidget {
     void set_page(Page *page);
     void style_rail() const;
     QWidget *control_bar() const;
-    QWidget *power_control() const;
 };
 
 class MainWindow : public QMainWindow {
diff --git a/src/app/pages/settings.cpp b/src/app/pages/settings.cpp
index e3e56e4..061fe05 100644
--- a/src/app/pages/settings.cpp
+++ b/src/app/pages/settings.cpp
@@ -20,6 +20,7 @@
 #include "app/pages/lighting_settings.hpp"
 #include "app/services/server.hpp"
 #include "app/widgets/color_picker.hpp"
+#include "app/widgets/dialog.hpp"
 #include "app/widgets/selector.hpp"
 #include "app/widgets/switch.hpp"
 #include "app/pages/network_settings.hpp"
@@ -233,13 +234,25 @@ QWidget *MainSettingsTab::controls_widget()
     auto widget = new QWidget();
     auto layout = new QVBoxLayout(widget);
 
-    // Head unit: reboot is the only control (no minimize, exit or shut down)
-    auto reboot_button = new QPushButton("reboot");
-    connect(reboot_button, &QPushButton::clicked, [this]{
+    // Head unit: restart is the only control (no minimize, exit or shut down),
+    // and it asks first
+    auto dialog = new Dialog(this->arbiter, true, this->arbiter.window());
+    dialog->set_title("Restart");
+    auto question = new QLabel("Restart the radio now?");
+    question->setFont(this->arbiter.forge().font(14));
+    question->setContentsMargins(0, 8, 0, 8);
+    dialog->set_body(question);
+    dialog->set_cancel_text("No");
+    auto yes = new QPushButton("Yes");
+    connect(yes, &QPushButton::clicked, [this]{
         this->arbiter.settings().sync();
         sync();
         system(Session::System::REBOOT_CMD);
     });
+    dialog->set_button(yes);
+
+    auto reboot_button = new QPushButton("restart");
+    connect(reboot_button, &QPushButton::clicked, [dialog]{ dialog->open(); });
     layout->addWidget(reboot_button);
 
     return widget;
