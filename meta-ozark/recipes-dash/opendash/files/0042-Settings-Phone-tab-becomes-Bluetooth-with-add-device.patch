+// Pairs a device from the unit's side. Legacy devices (most OBD adapters) ask
+// for a PIN: try each of `pins` until one works.
+void PhoneSettingsTab::pair_device(BluezQt::DevicePtr device, QStringList pins)
+{
+    QWidget *row = this->nearby_rows.value(device->address());
+    auto state = row ? row->findChild<QLabel *>("state") : nullptr;
+    auto action = row ? row->findChild<QPushButton *>("action") : nullptr;
+    if (row) {
+        row->setProperty("busy", true);
+        action->setEnabled(false);
+        state->setText(pins.size() > 1 ? "Pairing…" : QString("Pairing (PIN %1)…").arg(pins.first()));
+    }
+
+    const bool was_pairing = this->agent->pairing_mode;
+    this->agent->pairing_mode = true;
+    this->agent->pin = pins.first();
+    // Discovery slows pairing down and some adapters time out
+    if (this->adapter && this->adapter->isDiscovering())
+        this->adapter->stopDiscovery();
+
+    BluezQt::PendingCall *call = device->pair();
+    connect(call, &BluezQt::PendingCall::finished, this, [this, device, pins, was_pairing](BluezQt::PendingCall *call){
+        this->agent->pin.clear();
+        this->agent->pairing_mode = was_pairing || this->pair_button->isChecked();
+        if (this->scan_button->isChecked() && this->adapter)
+            this->adapter->startDiscovery();
+
+        const QString address = device->address();
+        QWidget *row = this->nearby_rows.value(address);
+        if (!call->error()) {
+            DASH_LOG(info) << "[Phone] Paired " << device->name().toStdString();
+            device->setTrusted(true);
+            if (kind_of(device) == Kind::Obd)
+                this->use_for_obd(address);
+            this->update_device(device);
+            return;
+        }
+
+        DASH_LOG(info) << "[Phone] Pairing " << device->name().toStdString() << " failed: " << call->errorText().toStdString();
+        const bool wrong_pin = call->error() == BluezQt::PendingCall::AuthenticationFailed ||
+                               call->error() == BluezQt::PendingCall::AuthenticationRejected;
+        if (wrong_pin && pins.size() > 1) {
+            this->pair_device(device, pins.mid(1));
+            return;
+        }
+        if (row) {
+            row->setProperty("busy", false);
+            row->findChild<QPushButton *>("action")->setEnabled(true);
+            row->findChild<QLabel *>("state")->setText(
+                wrong_pin ? "Couldn't pair: the device didn't accept the PIN (1234 or 0000)"
+                          : QString("Couldn't pair: %1. Make sure it's on and close by.").arg(call->errorText()));
+        }
+    });
+}
