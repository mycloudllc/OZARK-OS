+void BluetoothPlayerTab::show_track(const BluezQt::MediaPlayerTrack &track)
+{
+    this->now_playing->set_track(track.title().isEmpty() ? QString("Unknown title") : track.title(), track.artist(), track.album());
+    this->duration = track.duration();
+    this->position_base = this->player ? this->player->position() : 0;
+    this->since_report.restart();
+    this->tick();
+}
+
+void BluetoothPlayerTab::tick()
+{
+    qint64 position = this->position_base;
+    if (this->playing && this->since_report.isValid())
+        position += this->since_report.elapsed();
+    if (this->duration > 0)
+        position = std::min(position, this->duration);
+    this->now_playing->set_position(position, this->duration);
 }
 
