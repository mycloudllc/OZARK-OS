+void RadioPlayerTab::set_playing(bool playing)
+{
+    RadioPlugin *plugin = qobject_cast<RadioPlugin *>(this->loader.instance());
+    if (plugin) {
+        if (playing)
+            plugin->play();
+        else
+            plugin->stop();
+    }
+    this->play_button->setChecked(plugin && playing);
+    this->report();
+}
+
+void RadioPlayerTab::save_preset(int index)
+{
+    const QString key = "Pages/Media/Radio/Presets/" + this->band_key();
+    QStringList presets = this->settings.value(key).toStringList();
+    while (presets.size() < PRESETS)
+        presets << QString();
+    presets[index] = QString::number(this->tuner->value());
+    this->settings.setValue(key, presets);
+    this->update_presets();
+}
+
+void RadioPlayerTab::report()
+{
+    QVariantList presets;
+    const QStringList saved = this->settings.value("Pages/Media/Radio/Presets/" + this->band_key()).toStringList();
+    for (int i = 0; i < PRESETS; i++) {
+        const int station = saved.value(i).toInt();
+        presets << QVariantMap{{"index", i}, {"value", station}, {"label", station > 0 ? this->tuner->label(station) : QString()}};
+    }
+    const bool am = this->tuner->band() == Tuner::Band::AM;
+    MediaRemote::instance().report("radio", {
+        {"available", this->loader.isLoaded() && this->loader.instance()},
+        {"playing", this->play_button->isChecked()},
+        {"band", am ? "am" : "fm"},
+        {"value", this->tuner->value()},
+        {"freq_hz", this->tuner->hz()},
+        {"label", this->tuner->label(this->tuner->value())},
+        {"unit", am ? "kHz" : "MHz"},
+        {"min", this->tuner->minimum()},
+        {"max", this->tuner->maximum()},
+        {"presets", presets},
+        {"title", QString("%1 %2").arg(this->tuner->label(this->tuner->value()), am ? "kHz" : "MHz")},
+    });
+}
+
