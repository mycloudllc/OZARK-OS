-    background-color: rgb(25, 25, 25);
-    border-bottom: 1px solid rgb(66, 66, 66);
-    selection-background-color: transparent;
-    selection-color: rgb(255, 255, 255);
-}
-
 QComboBox::drop-down,
 QDateTimeEdit::drop-down {
     border: none;
@@ -298,39 +427,44 @@ QDateTimeEdit::down-arrow {
 }
 
 QComboBox QAbstractItemView {
-    color: rgb(255, 255, 255);
-    background-color: rgb(46, 46, 46);
-    selection-color: rgb(255, 255, 255);
-    selection-background-color: rgb(66, 66, 66);
-    border: 1px solid rgb(66, 66, 66);
+    color: @md-on-surface;
+    background-color: @md-surface-container;
+    selection-color: @md-on-secondary-container;
+    selection-background-color: @md-secondary-container;
+    border: none;
+    border-radius: 4px;
     outline: 0;
 }
 
 QLineEdit {
-    border-top-left-radius: 6px;
-    border-top-right-radius: 6px;
-    border-bottom-left-radius: 1px;
-    border-bottom-right-radius: 1px;
+    border-top-left-radius: 4px;
+    border-top-right-radius: 4px;
+    border-bottom-left-radius: 0px;
+    border-bottom-right-radius: 0px;
     border: none;
-    padding: 12px;
-    color: rgb(255, 255, 255);
-    background-color: rgb(25, 25, 25);
-    border-bottom: 1px solid rgb(66, 66, 66);
+    padding: 12px 16px;
+    color: @md-on-surface;
+    background-color: @md-surface-container-highest;
+    border-bottom: 1px solid @md-on-surface-variant;
+    selection-background-color: @md-primary/40;
 }
 
 QLineEdit:focus {
-    background-color: rgb(29, 29, 29);
-    border-bottom: 2px solid palette(base);
+    border-bottom: 2px solid @md-primary;
 }
 
+/* M3 switch: outlined track and small thumb off; primary track, big thumb on */
 Switch {
-    qproperty-track_color: rgba(255, 255, 255, 31);
-    qproperty-thumb_color: rgb(158, 158, 158);
+    qproperty-track_color: @md-surface-container-highest;
+    qproperty-thumb_color: @md-outline;
+    qproperty-outline_color: @md-outline;
+    qproperty-checked_track_color: @md-primary;
+    qproperty-checked_thumb_color: @md-on-primary;
 }
 
 Tuner {
-    qproperty-color: rgb(224, 224, 224);
-    qproperty-accent: palette(base);
+    qproperty-color: @md-on-surface-variant;
+    qproperty-accent: @md-primary;
 }
 
 Tuner::groove {
@@ -348,45 +482,43 @@ Tuner::sub-page {
 }
 
 StepMeter {
-    qproperty-base_color: palette(alternate-base);
-    qproperty-bar_color: palette(base);
+    qproperty-base_color: @md-secondary-container;
+    qproperty-bar_color: @md-primary;
 }
 
 ClimateState {
-    qproperty-color: rgb(228, 228, 228);
+    qproperty-color: @md-on-surface;
 }
 
 VehicleState {
-    qproperty-base_color: rgb(228, 228, 228);
+    qproperty-base_color: @md-on-surface;
     qproperty-headlight_color: #4FC3F7;
     qproperty-taillight_color: #E57373;
     qproperty-indicator_color: #FFB74D;
-    qproperty-warning_color: #FF7043;
+    qproperty-warning_color: @md-error;
 }
 
+/* Dialogs: an extra-large rounded surface */
 QDialog,
 QDialog > QFrame {
-    background-color: rgb(56, 56, 56);
-    border-radius: 8px;
-    border: 2px solid rgb(66, 66, 66);
+    background-color: @md-surface-container-high;
+    border-radius: 28px;
+    border: none;
 }
 
 #ControlBar {
-    background-color: rgb(48, 48, 48);
-    border-top-left-radius: 6px;
-    border-top-right-radius: 6px;
+    background-color: @md-surface-container;
+    border-top-left-radius: 16px;
+    border-top-right-radius: 16px;
 }
 
 #StatusBar {
-    background-color: rgba(255, 255, 255, 4);
-    border-top-left-radius: 4px;
-    border-top-right-radius: 4px;
-    border-bottom-left-radius: 4px;
-    border-bottom-right-radius: 4px;
+    background-color: @md-surface-container-high;
+    border-radius: 12px;
     margin: 2px;
 }
 
 *[add_hint="true"] {
-    background-color: rgba(255, 255, 255, 31);
-    border-radius: 8px;
+    background-color: @md-on-surface/12;
+    border-radius: 12px;
 }
