[Unit]
Description=Ozark remote control: the phone app over Wi-Fi and Bluetooth LE (org.ozark.Remote1)
After=dbus.service bluetooth.service ozark-data.service
Wants=bluetooth.service

[Service]
Type=dbus
BusName=org.ozark.Remote1
ExecStart=/usr/bin/ozark-remoted
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
