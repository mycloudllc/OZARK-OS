+// A scroll area asks for less room than its contents need, so full-screen
+// dialogs came up with their body clipped behind a scrollbar. Ask for the whole
+// body, up to the space the window has; it only scrolls beyond that.
+void Dialog::fit_body()
+{
+    if (!this->scroll || !this->scroll->widget())
+        return;
+    QWidget *parent = this->parentWidget();
+    if (!parent)
+        return;
+    const int margin = std::ceil(24 * this->arbiter.layout().scale) * 2;
+    this->scroll->setMinimumSize(0, 0);
+    const QSize chrome = this->sizeHint() - this->scroll->sizeHint();
+    const QSize room = parent->size() - QSize(margin, margin) - chrome;
+    this->scroll->setMinimumSize(this->scroll->widget()->sizeHint().boundedTo(room.expandedTo(QSize(0, 0))));
+    this->setMinimumSize(0, 0);
+    this->setMaximumSize(QWIDGETSIZE_MAX, QWIDGETSIZE_MAX);
+    // Not adjustSize(): that caps a window at 2/3 of the screen
+    this->resize(this->sizeHint());
+}
+
 void Dialog::set_title(QString str)
 {
     QLabel *label = new QLabel(str, this);
@@ -52,12 +74,12 @@ void Dialog::set_title(QString str)
