From 697a0003441218c4589c9f2cba506b639237062b Mon Sep 17 00:00:00 2001
From: Ozark <ozark@localhost>
Date: Sat, 31 Oct 2026 21:21:09 -0500
Subject: [PATCH] Restart from Settings only; Material-style scrollbars

- The control bar loses its restart button. Settings > Main > Controls
  "restart" now asks "Restart the radio now?" (No / Yes) first, instead of
  restarting on the first tap.
- Scrollbars: a thin rounded thumb (Material style), no track or arrow
  buttons, in both themes.
---
 assets/stylesheets/dark.qss  | 36 +++++++++++++++++++++++++++++-------
 assets/stylesheets/light.qss | 36 +++++++++++++++++++++++++++++-------
 include/app/window.hpp       |  1 -
 src/app/pages/settings.cpp   | 19 ++++++++++++++++---
 src/app/window.cpp           | 25 +------------------------
 5 files changed, 75 insertions(+), 42 deletions(-)

diff --git a/assets/stylesheets/dark.qss b/assets/stylesheets/dark.qss
index 042f628..025ff04 100644
--- a/assets/stylesheets/dark.qss
+++ b/assets/stylesheets/dark.qss
@@ -204,27 +204,49 @@ QScrollArea > QWidget > QWidget {
     background-color: transparent;
 }
 
+/* Material-style: a thin rounded thumb, no track, no arrow buttons */
 QScrollBar {
     background-color: transparent;
+    border: none;
 }
 
 QScrollBar:vertical {
-    padding-top: 6px;
-    padding-bottom: 6px;
-    width: 16px;
+    width: 10px;
+    margin: 4px 2px 4px 2px;
+}
+
+QScrollBar:horizontal {
+    height: 10px;
+    margin: 2px 4px 2px 4px;
 }
 
 QScrollBar::handle {
-    background-color: rgba(255, 255, 255, 31);
-    border-radius: 8px;
+    background-color: rgba(255, 255, 255, 97);
+    border-radius: 3px;
 }
 
-QScrollBar::add-line {
-    border: none;
+QScrollBar::handle:pressed {
+    background-color: rgba(255, 255, 255, 153);
 }
 
+QScrollBar::handle:vertical {
+    min-height: 32px;
+}
+
+QScrollBar::handle:horizontal {
+    min-width: 32px;
+}
+
+QScrollBar::add-line,
 QScrollBar::sub-line {
     border: none;
+    width: 0px;
+    height: 0px;
+}
+
+QScrollBar::add-page,
+QScrollBar::sub-page {
+    background: none;
 }
 
 QLineEdit {
diff --git a/assets/stylesheets/light.qss b/assets/stylesheets/light.qss
index 5178422..016aacc 100644
--- a/assets/stylesheets/light.qss
+++ b/assets/stylesheets/light.qss
@@ -204,27 +204,49 @@ QScrollArea > QWidget > QWidget {
     background-color: transparent;
