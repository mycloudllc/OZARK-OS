+// Same look as Dash's dialogs in each mode (light.qss / dark.qss). Dash's
+// palette only carries the accent colour (base), so window/mid would stay
+// light in dark mode: the colours are spelled out instead.
+void Osd::apply_theme()
+{
+    const bool dark = this->arbiter.theme().mode == Session::Theme::Dark;
+    this->panel->setStyleSheet(QString(
+        "QFrame#OsdPanel { background-color: %1; border: 2px solid %2; border-radius: %3px; }"
+        "QProgressBar { background-color: %4; border: none; border-radius: 2px; }"
+        "QProgressBar::chunk { background-color: palette(base); border-radius: 2px; }")
+        .arg(dark ? "rgb(56, 56, 56)" : "rgb(255, 255, 255)")
+        .arg(dark ? "rgb(66, 66, 66)" : "rgb(224, 224, 224)")
+        .arg(int(14 * this->arbiter.layout().scale))
+        .arg(dark ? "rgba(255, 255, 255, 46)" : "rgba(0, 0, 0, 31)"));
+}
