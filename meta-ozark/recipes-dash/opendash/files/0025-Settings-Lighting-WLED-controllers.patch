+    }
+    else {
+        this->state->setText(wled ? "Searching for WLED on USB..." : "Searching for controller...");
+    }
 
     this->loading = true;
     this->port->set_current(status.value("port", "auto").toString());
+    this->type->set_current(wled ? kWled : kOzark);
+    this->link->set_current(link_option(status.value("link", "network").toString()));
+    this->baud->set_current(QString::number(status.value("baud", 115200).toInt()));
