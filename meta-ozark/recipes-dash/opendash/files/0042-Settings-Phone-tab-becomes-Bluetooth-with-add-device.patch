+// ---------------------------------------------------------------- add device
+
+PhoneSettingsTab::Kind PhoneSettingsTab::kind_of(BluezQt::DevicePtr device)
+{
+    // BLE tire sensors: company 0x0100, 16 bytes (what the vehicle service decodes)
+    const auto data = device->manufacturerData();
+    if (data.contains(0x0100) && data.value(0x0100).size() == 16)
+        return Kind::Tire;
+    static const QRegularExpression obd("OBD|ELM ?327|V-?LINK|VGATE|VEEPEAK|KONNWEI|ICAR|BAFX|CARISTA|KIWI|SCAN ?TOOL",
+                                        QRegularExpression::CaseInsensitiveOption);
+    if (obd.match(device->name()).hasMatch())
+        return Kind::Obd;
+    if (device->type() == BluezQt::Device::Phone)
+        return Kind::Phone;
+    return Kind::Other;
+}
+
+QString PhoneSettingsTab::icon_for(Kind kind)
+{
+    switch (kind) {
+        case Kind::Phone: return "smartphone";
+        case Kind::Obd: return "directions_car";
+        case Kind::Tire: return "speed";
+        default: return "bluetooth";
+    }
+}
+
+void PhoneSettingsTab::set_scanning(bool enabled)
+{
+    if (enabled && !this->adapter) {
+        this->scan_button->setChecked(false);
+        return;
+    }
+    if (this->adapter) {
+        if (enabled) {
+            if (!this->adapter->isPowered())
+                this->adapter->setPowered(true);
+            // Classic (OBD adapters, phones) and LE (tire sensors), duplicates
+            // included so sensors' readings keep arriving
+            this->adapter->setDiscoveryFilter({{"Transport", "auto"}, {"DuplicateData", true}});
+            this->adapter->startDiscovery();
+            this->scan_timer->start();
+        }
+        else {
+            this->scan_timer->stop();
+            if (this->adapter->isDiscovering())
+                this->adapter->stopDiscovery();
+        }
+    }
+    this->scan_button->setChecked(enabled);
+    this->scan_button->setText(enabled ? "stop" : "add device");
+    this->nearby->setVisible(enabled || !this->nearby_rows.isEmpty());
+    this->nearby_hint->setText(enabled
+        ? "Looking for devices… Turn on the OBD adapter (plug it in, ignition on). Tire sensors show up "
+          "once they send a reading: pump or let some air out, or drive a short way."
+        : "Not looking any more. Tap “add device” to look again.");
+    if (enabled && this->adapter)
+        for (auto device : this->adapter->devices())
+            this->update_nearby(device);
+}
+
+void PhoneSettingsTab::update_nearby(BluezQt::DevicePtr device)
+{
+    const QString address = device->address();
+    const Kind kind = kind_of(device);
+    // Only while scanning, only unpaired, and not the many nameless LE adverts
+    if (device->isPaired() || (!this->scan_button->isChecked() && !this->nearby_rows.contains(address)))
+        return;
+    if (kind != Kind::Tire && (device->name().isEmpty() || device->name() == device->address().replace(':', '-')))
+        return;
+
+    QWidget *row = this->nearby_rows.value(address);
+    if (!row) {
+        row = new QFrame();
+        row->setProperty("md", "card");
+        auto layout = new QHBoxLayout(row);
+        layout->setContentsMargins(12, 6, 12, 6);
+        auto icon = new QPushButton(row);
+        icon->setFlat(true);
+        icon->setFocusPolicy(Qt::NoFocus);
+        icon->setAttribute(Qt::WA_TransparentForMouseEvents);
+        this->arbiter.forge().iconize(icon_for(kind), icon, 28);
+        layout->addWidget(icon);
+
+        auto text = new QVBoxLayout();
+        auto name = new QLabel(row);
+        name->setObjectName("name");
+        name->setFont(this->arbiter.forge().font(14));
+        text->addWidget(name);
+        auto state = new QLabel(row);
+        state->setObjectName("state");
+        state->setProperty("muted", true);
+        state->setFont(this->arbiter.forge().font(11));
+        state->setWordWrap(true);
+        text->addWidget(state);
+        layout->addLayout(text, 1);
+
+        auto action = new QPushButton(row);
+        action->setObjectName("action");
+        action->setFont(this->arbiter.forge().font(14));
+        action->setFlat(true);
+        connect(action, &QPushButton::clicked, [this, device]{
+            if (kind_of(device) == Kind::Tire)
+                this->choose_wheel(device);
+            else if (kind_of(device) == Kind::Obd)
+                this->pair_device(device, {"1234", "0000"});
+            else
+                this->pair_device(device, {"0000", "1234"});
+        });
+        layout->addWidget(action);
+
+        this->nearby_list->addWidget(row);
+        this->nearby_rows.insert(address, row);
+        this->nearby->show();
+    }
+
+    auto name = row->findChild<QLabel *>("name");
+    auto state = row->findChild<QLabel *>("state");
+    auto action = row->findChild<QPushButton *>("action");
+    if (row->property("busy").toBool())
+        return;  // pairing: leave its message alone
+    const QString signal = device->rssi() != -32768 && device->rssi() != 0 ? QString(" · %1 dBm").arg(device->rssi()) : QString();
+    switch (kind) {
+        case Kind::Tire: {
+            name->setText(device->name().isEmpty() || device->name() == QString(address).replace(':', '-') ? "Tire sensor" : device->name());
+            const QString wheel = this->wheels.value(address.toUpper());
+            state->setText(QString("%1%2%3").arg(address)
+                               .arg(wheel.isEmpty() ? QString() : " · " + wheel_label(wheel)).arg(signal));
+            action->setText(wheel.isEmpty() ? "set wheel" : "change wheel");
+            break;
+        }
+        case Kind::Obd:
+            name->setText(device->name());
+            state->setText("OBD-II adapter" + signal);
+            action->setText("pair");
+            break;
+        case Kind::Phone:
+            name->setText(device->name());
+            state->setText("Phone" + signal);
+            action->setText("pair");
+            break;
+        default:
+            name->setText(device->name());
+            state->setText("Bluetooth device" + signal);
+            action->setText("pair");
+            break;
+    }
+}
+
+void PhoneSettingsTab::remove_nearby(const QString &address)
+{
+    QWidget *row = this->nearby_rows.take(address);
+    if (row)
+        row->deleteLater();
+    if (this->nearby_rows.isEmpty() && !this->scan_button->isChecked())
+        this->nearby->hide();
+}
