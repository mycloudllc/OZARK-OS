# Read by Ozark OS UI services (EnvironmentFile=/etc/default/ozark-display).

# Draw straight to the screen through KMS/DRM, no window system.
QT_QPA_PLATFORM=eglfs
QT_QPA_EGLFS_INTEGRATION=eglfs_kms
QT_QPA_EGLFS_KMS_CONFIG=/etc/ozark/eglfs-kms.json
QT_QPA_EGLFS_ALWAYS_SET_MODE=1

# Text size: Qt turns font point sizes into pixels using the screen's DPI,
# which it works out from the physical size the display driver reports.
# Panel drivers often get that wrong (the Waveshare DSI driver reports a 7"
# screen for every model: about 211 DPI on the 8" 1280x800 panel, so all text
# came out about twice the intended size). Pin it instead: 180 suits the 8"
# panel in a vehicle (96 is Qt's standard, and was too small there). The
# QEMU emulator reads this file too, so it shows the same sizes. Lower or
# raise it for smaller or bigger text everywhere.
QT_FONT_DPI=180
# No QT_QPA_EGLFS_HIDECURSOR: EGLFS only draws a pointer when a mouse is
# connected, and apps decide when to hide it (Dash: DASH_CURSOR_AUTOHIDE).

# Touch and keyboard come through libinput (Qt's default on EGLFS).
# If a touchscreen reports rotated coordinates, set e.g.:
#QT_QPA_EGLFS_ROTATION=180

# Uncomment to debug display bring-up (output goes to the journal):
#QT_LOGGING_RULES=qt.qpa.*=true
#QT_QPA_EGLFS_DEBUG=1
