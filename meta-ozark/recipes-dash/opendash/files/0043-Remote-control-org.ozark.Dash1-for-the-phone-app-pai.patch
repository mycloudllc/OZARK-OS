index 0000000..8182ecd
--- /dev/null
+++ b/src/app/services/dash_remote.cpp
@@ -0,0 +1,258 @@
+#include "app/services/dash_remote.hpp"
+
+#include <QDBusConnection>
+#include <QDBusMessage>
+#include <QLabel>
+#include <QPushButton>
+#include <QVBoxLayout>
+
+#include "DashLog.hpp"
+#include "app/arbiter.hpp"
+#include "app/services/media_remote.hpp"
+#include "app/widgets/dialog.hpp"
+
+namespace {
+const char *kBadParams = "org.ozark.Dash1.Error.BadParams";
+const QString kRemote = "org.ozark.Remote1";
+const QString kRemotePath = "/org/ozark/Remote1";
+const QStringList kSources = {"radio", "bluetooth", "local"};
+}  // namespace
+
+DashRemote::DashRemote(Arbiter &arbiter, QObject *parent)
+    : QObject(parent)
+    , arbiter(arbiter)
+{
+    // Many changes come in bursts (a theme change, a new track): one signal for them
+    this->coalesce.setSingleShot(true);
+    this->coalesce.setInterval(150);
+    connect(&this->coalesce, &QTimer::timeout, this, [this] { emit StateChanged(this->GetState()); });
+    auto changed = [this] { this->coalesce.start(); };
+    connect(&arbiter, &Arbiter::volume_changed, this, changed);
+    connect(&arbiter, &Arbiter::brightness_changed, this, changed);
+    connect(&arbiter, &Arbiter::mode_changed, this, changed);
+    connect(&arbiter, &Arbiter::color_changed, this, changed);
+    connect(&arbiter, &Arbiter::curr_page_changed, this, changed);
+    connect(&arbiter, &Arbiter::page_changed, this, changed);
+    connect(&MediaRemote::instance(), &MediaRemote::changed, this, changed);
+
+    QDBusConnection bus = QDBusConnection::systemBus();
+    if (!bus.registerObject("/org/ozark/Dash1", this, QDBusConnection::ExportScriptableContents) ||
+        !bus.registerService("org.ozark.Dash1"))
+        DASH_LOG(error) << "[Remote] Can't register org.ozark.Dash1: " << bus.lastError().message().toStdString();
+    else
+        DASH_LOG(info) << "[Remote] org.ozark.Dash1 ready";
+
+    bus.connect(kRemote, kRemotePath, kRemote, "PairingStarted", this, SLOT(on_pairing_started(QString, QString, int)));
+    bus.connect(kRemote, kRemotePath, kRemote, "PairingEnded", this, SLOT(on_pairing_ended(QString, bool)));
+
+    this->ticker.setInterval(1000);
+    connect(&this->ticker, &QTimer::timeout, this, [this] {
+        if (--this->seconds_left <= 0) {
+            this->ticker.stop();
+            if (this->pairing)
+                this->pairing->close();
+            return;
+        }
+        if (this->countdown)
+            this->countdown->setText(QString("%1:%2").arg(this->seconds_left / 60).arg(this->seconds_left % 60, 2, 10, QChar('0')));
+    });
+}
+
+QVariantMap DashRemote::GetState() const
+{
+    QVariantList pages;
+    for (auto page : this->arbiter.layout().pages())
+        if (page->enabled())
+            pages << page->name();
+    auto curr = this->arbiter.layout().curr_page;
+    return {
+        {"volume", int(this->arbiter.system().volume)},
+        {"brightness", int(this->arbiter.system().brightness.value)},
+        {"mode", this->arbiter.theme().mode == Session::Theme::Dark ? "dark" : "light"},
+        {"color", this->arbiter.theme().color().name()},
+        {"page", curr ? curr->name() : QString()},
+        {"pages", pages},
+        {"media", MediaRemote::instance().state()},
+    };
+}
+
+QVariantMap DashRemote::fail(const QString &message)
+{
+    if (this->calledFromDBus())
+        this->sendErrorReply(kBadParams, message);
+    return {};
+}
+
+QVariantMap DashRemote::Control(const QString &method, const QVariantMap &params)
+{
+    const QVariantMap ok{{"ok", true}};
+    MediaRemote &media = MediaRemote::instance();
+
+    // ---- dash.*
+    if (method == "dash.volume") {
+        if (!params.contains("value"))
+            return this->fail("value: 0 to 100");
+        this->arbiter.set_volume(uint8_t(qBound(0, params.value("value").toInt(), 100)));
+        return ok;
+    }
+    if (method == "dash.volume_step") {
+        const int delta = params.value("delta", 2).toInt();
+        if (delta >= 0)
+            this->arbiter.increase_volume(uint8_t(qBound(0, delta, 100)));
+        else
+            this->arbiter.decrease_volume(uint8_t(qBound(0, -delta, 100)));
+        return ok;
+    }
+    if (method == "dash.brightness") {
+        if (!params.contains("value"))
+            return this->fail("value: 0 to 255");
+        this->arbiter.set_brightness(uint8_t(qBound(0, params.value("value").toInt(), 255)));
+        return ok;
+    }
+    if (method == "dash.theme") {
+        if (params.contains("mode")) {
+            const QString mode = params.value("mode").toString();
+            if (mode != "light" && mode != "dark")
+                return this->fail("mode: light or dark");
+            this->arbiter.set_mode(mode == "dark" ? Session::Theme::Dark : Session::Theme::Light);
+        }
+        if (params.contains("color")) {
+            const QColor color(params.value("color").toString());
+            if (!color.isValid())
+                return this->fail("color: #rrggbb");
+            this->arbiter.set_color(color);
+        }
+        return ok;
+    }
+    if (method == "dash.page") {
+        const QString name = params.value("name").toString();
+        for (auto page : this->arbiter.layout().pages()) {
+            if (page->enabled() && page->name().compare(name, Qt::CaseInsensitive) == 0) {
+                this->arbiter.set_curr_page(page);
+                return ok;
+            }
+        }
+        return this->fail("name: one of the enabled pages (state's \"pages\")");
+    }
+
+    // ---- media.*: to a source's tab
+    if (method.startsWith("media.")) {
+        const QString action = method.mid(6);
+        if (action == "source") {
+            const QString source = params.value("source").toString();
+            if (!kSources.contains(source))
+                return this->fail("source: radio, bluetooth or local");
+            media.set_active(source);
+            emit media.show(source);
+            return ok;
+        }
+        static const QStringList actions = {"play", "pause", "toggle", "next", "previous"};
+        if (!actions.contains(action))
+            return this->fail("media: play, pause, toggle, next, previous or source");
+        const QString source = params.value("source", media.active()).toString();
+        if (!kSources.contains(source))
+            return this->fail("source: radio, bluetooth or local");
+        if (!media.state(source).value("available").toBool())
+            return this->fail(source == "bluetooth" ? "Nothing is playing over Bluetooth"
+                              : source == "radio"   ? "No radio tuner is loaded"
+                                                    : "No music on the radio");
+        emit media.request(source, action, params);
+        return ok;
+    }
+
+    // ---- radio.*
+    if (method.startsWith("radio.")) {
+        const QString action = method.mid(6);
+        if (action == "band") {
+            const QString band = params.value("band").toString();
+            if (band != "fm" && band != "am")
+                return this->fail("band: fm or am");
+        }
+        else if (action == "tune") {
+            if (!params.contains("freq_hz") && !params.contains("value"))
+                return this->fail("freq_hz (e.g. 101500000), or value as the radio shows it (1015 = 101.5 MHz)");
+        }
+        else if (action == "preset" || action == "save_preset") {
+            const int index = params.value("index", -1).toInt();
+            if (index < 0 || index >= 6)
+                return this->fail("index: 0 to 5");
+        }
+        else if (action != "play" && action != "stop" && action != "step") {
+            return this->fail("radio: play, stop, tune, step, band, preset or save_preset");
+        }
+        emit media.request("radio", action, params);
+        return ok;
+    }
+
+    return this->fail(QString("Dash has no method %1").arg(method));
+}
+
+// ---------------------------------------------------------------- pairing
+
+void DashRemote::on_pairing_started(const QString &code, const QString &name, int seconds)
+{
+    if (this->pairing)
+        this->pairing->close();
+    DASH_LOG(info) << "[Remote] Pairing code shown for " << name.toStdString();
+
+    auto dialog = new Dialog(this->arbiter, true, this->arbiter.window());
+    dialog->setAttribute(Qt::WA_DeleteOnClose);
+    dialog->set_title(QString("Pair %1 with the radio?").arg(name));
+
+    auto body = new QWidget();
+    auto layout = new QVBoxLayout(body);
+    auto code_label = new QLabel(code.left(3) + " " + code.mid(3), body);
+    QFont code_font(this->arbiter.forge().font(32));
+    code_font.setBold(true);
+    code_font.setLetterSpacing(QFont::AbsoluteSpacing, 4);
+    code_label->setFont(code_font);
+    code_label->setAlignment(Qt::AlignCenter);
+    layout->addWidget(code_label);
+    auto hint = new QLabel(QString("Enter this code in the Ozark Remote app on %1.").arg(name), body);
+    hint->setFont(this->arbiter.forge().font(12));
+    hint->setAlignment(Qt::AlignCenter);
+    hint->setWordWrap(true);
+    layout->addWidget(hint);
+    this->countdown = new QLabel(body);
+    this->countdown->setProperty("muted", true);
+    this->countdown->setFont(this->arbiter.forge().font(11));
+    this->countdown->setAlignment(Qt::AlignCenter);
+    layout->addWidget(this->countdown);
+    dialog->set_body(body);
+    dialog->set_cancel_text("cancel");
+
+    // Closing it (cancel, or tapping outside) stops the pairing
+    connect(dialog, &QObject::destroyed, this, [this] {
+        this->countdown = nullptr;
+        this->ticker.stop();
+        if (this->seconds_left > 0)
+            QDBusConnection::systemBus().asyncCall(
+                QDBusMessage::createMethodCall(kRemote, kRemotePath, kRemote, "CancelPairing"));
+        this->seconds_left = 0;
+    });
+
+    this->pairing = dialog;
+    this->seconds_left = seconds;
+    this->countdown->setText(QString("%1:%2").arg(seconds / 60).arg(seconds % 60, 2, 10, QChar('0')));
+    this->ticker.start();
+    dialog->open();
+}
+
+void DashRemote::on_pairing_ended(const QString &name, bool paired)
+{
+    this->seconds_left = 0;  // ended by the service: don't cancel it again
+    if (this->pairing)
+        this->pairing->close();
+    if (!paired)
+        return;
+    DASH_LOG(info) << "[Remote] Paired " << name.toStdString();
+    auto done = new Dialog(this->arbiter, true, this->arbiter.window());
+    done->setAttribute(Qt::WA_DeleteOnClose);
+    done->set_title(QString("%1 is paired").arg(name));
+    auto body = new QLabel("It can now control the radio. Remove it in Settings > Bluetooth.");
+    body->setWordWrap(true);
+    body->setFont(this->arbiter.forge().font(12));
+    done->set_body(body);
+    done->set_cancel_text("ok");
+    done->open(4000);
+}
diff --git a/src/app/services/media_remote.cpp b/src/app/services/media_remote.cpp
new file mode 100644
index 0000000..056d8ce
--- /dev/null
+++ b/src/app/services/media_remote.cpp
@@ -0,0 +1,43 @@
+#include "app/services/media_remote.hpp"
+
+MediaRemote &MediaRemote::instance()
+{
+    static MediaRemote remote;
+    return remote;
+}
+
+void MediaRemote::report(const QString &source, const QVariantMap &state)
+{
+    QVariantMap current = this->sources.value(source).toMap();
+    bool changed = false;
+    for (auto it = state.begin(); it != state.end(); ++it) {
+        if (current.value(it.key()) != it.value()) {
+            current[it.key()] = it.value();
+            changed = true;
+        }
+    }
+    // Starting to play makes a source the one the remote's controls go to
+    if (state.value("playing").toBool() && this->active_ != source) {
+        this->active_ = source;
+        changed = true;
+    }
+    if (!changed)
+        return;
+    this->sources[source] = current;
+    emit this->changed();
+}
+
+QVariantMap MediaRemote::state() const
+{
+    QVariantMap out = this->sources;
+    out["active"] = this->active_;
+    return out;
+}
+
+void MediaRemote::set_active(const QString &source)
+{
+    if (this->active_ == source)
+        return;
+    this->active_ = source;
+    emit this->changed();
+}
