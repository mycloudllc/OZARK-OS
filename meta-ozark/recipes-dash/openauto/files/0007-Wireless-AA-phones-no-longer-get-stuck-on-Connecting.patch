+                tcpWrapper_.close(*socket);
+                OPENAUTO_LOG(warning) << "[App] android auto entity is still running (USB).";
+                this->waitForWirelessDevice();
+                return;
+            }
+
+            // A phone connecting over Wi-Fi again means the session it had is
+            // gone (it left the hotspot, or gave up), even if that session
