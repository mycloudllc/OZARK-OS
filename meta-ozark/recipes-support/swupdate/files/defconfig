# SWUpdate for Ozark OS: run on demand by ozark-update (no daemon, no web
# server), installing signed .swu files into the other A/B system slot.
# The Pi boots without U-Boot, so no bootloader environment: ozark-update
# switches slots with the firmware's tryboot.txt / config.txt.
CONFIG_HAVE_DOT_CONFIG=y
CONFIG_DEFAULT_CONFIG_FILE="/etc/swupdate.cfg"
CONFIG_SCRIPTS=y
CONFIG_HW_COMPATIBILITY=y
CONFIG_HW_COMPATIBILITY_FILE="/etc/hwrevision"
CONFIG_SW_VERSIONS_FILE="/etc/sw-versions"
CONFIG_SOCKET_CTRL_PATH=""
CONFIG_SOCKET_PROGRESS_PATH=""
CONFIG_BOOTLOADER_NONE=y
CONFIG_BOOTLOADER_DEFAULT_NONE=y
# CONFIG_UBOOT is not set
# CONFIG_MTD is not set
# CONFIG_CFI is not set
# CONFIG_LUA is not set
# CONFIG_WEBSERVER is not set
# CONFIG_MONGOOSE is not set
# CONFIG_DOWNLOAD is not set
# CONFIG_SURICATTA is not set
CONFIG_SSL_IMPL_OPENSSL=y
CONFIG_HASH_VERIFY=y
CONFIG_SIGNED_IMAGES=y
CONFIG_SIGALG_RAWRSA=y
CONFIG_GUNZIP=y
CONFIG_ZSTD=y
CONFIG_LIBCONFIG=y
CONFIG_PARSERROOT=""
CONFIG_RAW=y
CONFIG_ARCHIVE=y
CONFIG_SHELLSCRIPTHANDLER=y
