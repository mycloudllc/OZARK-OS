+// Fresh choices each time the tab is shown: adapters come and go
+void VehicleSettingsTab::refresh()
+{
+    VehicleClient &client = VehicleClient::instance();
+    client.call("GetSerialPorts", {}, [this](const QVariantList &r) {
+        QStringList paths = r.value(0).toStringList();
+        // The chosen port, even while it's unplugged
+        const QString chosen = this->config.value("obd_serial").toString();
+        if (!chosen.isEmpty() && !paths.contains(chosen))
+            paths.prepend(chosen);
+        QStringList names;
+        for (const QString &p : paths)
+            names << port_label(p);
+        this->loading = true;
+        this->port->setProperty("paths", paths);
+        this->port->set_options(names);
+        this->port->set_current(port_label(this->config.value("obd_serial").toString()));
+        this->loading = false;
+    });
+    client.call("GetBluetoothDevices", {}, [this](const QVariantList &r) {
+        const QStringList devices = r.value(0).toStringList();
+        this->loading = true;
+        this->bt->set_options(devices);
+        const QString address = this->config.value("obd_bt_address").toString();
+        for (const QString &d : devices)
+            if (d.startsWith(address) && !address.isEmpty())
+                this->bt->set_current(d);
+        this->loading = false;
+    });
+    client.call("GetCanInterfaces", {}, [this](const QVariantList &r) {
+        this->loading = true;
+        this->can->set_options(r.value(0).toStringList());
+        this->can->set_current(this->config.value("can_interface").toString());
+        this->loading = false;
+    });
+    client.call("GetGpioLines", {}, [this](const QVariantList &r) {
+        QStringList options = {kNone};
+        this->line_ids = QStringList(QString());
+        for (const QVariant &v : r.value(0).toList()) {
+            const QVariantMap l = v.toMap();
+            if (l.value("used").toBool())
+                continue;  // the kernel or another program has it
+            options << l.value("label").toString();
+            this->line_ids << l.value("id").toString();
+        }
+        this->loading = true;
+        this->line->setProperty("labels", options);
+        this->line->set_options(options);
+        const int i = this->line_ids.indexOf(this->config.value("illum_line").toString());
+        this->line->set_current(options.value(i > 0 ? i : 0));
+        this->loading = false;
+    });
+    client.call("GetConfig", {}, [this](const QVariantList &r) { this->show_config(r.value(0).toMap()); });
+    client.refresh();
+    this->refresh_sensors();
+}
+
+void VehicleSettingsTab::show_config(const QVariantMap &c)
+{
+    this->config = c;
+    this->loading = true;
+    this->link->set_current(label_for(kLinks, c.value("obd_link").toString()));
+    this->port->set_current(port_label(c.value("obd_serial").toString()));
+    this->can->set_current(c.value("can_interface").toString());
+    this->bitrate->set_current(label_for(kBitrates, QString::number(c.value("can_bitrate").toInt())));
+    const int i = this->line_ids.indexOf(c.value("illum_line").toString());
+    if (i > 0)
+        this->line->set_current(this->line->property("labels").toStringList().value(i));
+    this->active_low->setChecked(c.value("illum_active_low").toBool());
+    this->bias->set_current(label_for(kBias, c.value("illum_bias").toString()));
+    this->ble->setChecked(c.value("tpms_ble").toBool());
+    this->hub_tires->setChecked(c.value("tpms_hub").toBool());
+    const double low_kpa = c.value("tpms_low_kpa").toDouble(), high_c = c.value("tpms_high_c").toDouble();
+    this->low->setSuffix(si() ? " kPa" : " psi");
+    this->low->setValue(qRound(si() ? low_kpa : low_kpa / 6.89476));
+    this->hot->setSuffix(si() ? " °C" : " °F");
+    this->hot->setValue(qRound(si() ? high_c : high_c * 9 / 5 + 32));
+    this->forward->setChecked(c.value("hub_forward").toBool());
+    this->hub_url->set_value(c.value("hub_url").toString());
+    this->hub_pin->set_placeholder(c.value("hub_pin_set").toBool() ? "set" : "same as the TrailCommand tab");
+    this->loading = false;
+    this->show_mode();
+}
+
+// Only the rows that matter for the choices made
+void VehicleSettingsTab::show_mode()
+{
+    const QString link = key_for(kLinks, this->link->get_current());
+    this->port_row->setVisible(link == "elm327-usb");
+    this->bt_row->setVisible(link == "elm327-bt");
+    this->can_row->setVisible(link == "can");
+    this->bitrate_row->setVisible(link == "can");
+    const bool has_line = this->line->get_current() != kNone;
+    this->active_low_row->setVisible(has_line);
+    this->bias_row->setVisible(has_line);
+}
+
+void VehicleSettingsTab::show_status()
+{
+    const QVariantMap status = VehicleClient::instance().status;
+    if (status.isEmpty()) {
+        this->obd_state->setText("Vehicle service not running");
+        return;
+    }
+    const QVariantMap obd = status.value("obd").toMap();
+    this->obd_state->setText(obd.value("state").toString() == "off" ? QString("Off") : obd.value("message").toString());
+
+    const QVariantMap illum = status.value("illumination").toMap();
+    if (illum.value("line").toString().isEmpty())
+        this->illum_state->setText("Not set up");
+    else if (!illum.value("ok").toBool())
+        this->illum_state->setText(illum.value("message").toString());
+    else
+        this->illum_state->setText(illum.value("on").toBool() ? "On" : "Off");
+
+    this->tpms_state->setText(status.value("tpms").toMap().value("message").toString());
+    this->hub_state->setText(status.value("hub").toMap().value("message").toString());
+}
+
+void VehicleSettingsTab::refresh_sensors()
+{
+    VehicleClient::instance().call("GetTpmsSensors", {}, [this](const QVariantList &r) {
+        const QVariantList list = r.value(0).toList();
+        const bool metric = si();
+        QSet<QString> seen;
+        for (const QVariant &v : list) {
+            const QVariantMap s = v.toMap();
+            const QString id = s.value("id").toString();
+            seen.insert(id);
+            if (!this->sensor_rows.contains(id)) {
+                SensorRow row;
+                row.widget = new QWidget(this->sensors);
+                auto l = new QHBoxLayout(row.widget);
+                l->setContentsMargins(0, 0, 0, 0);
+                row.label = new QLabel(row.widget);
+                row.label->setWordWrap(true);
+                l->addWidget(row.label, 1);
+                row.position = new Selector(labels(kPositions), kPositions.first().second,
+                                            this->arbiter.forge().font(14), this->arbiter, row.widget);
+                connect(row.position, &Selector::item_changed, [this, id](QString item) {
+                    if (!this->loading)
+                        VehicleClient::instance().call("AssignTpmsSensor", {key_for(kPositions, item), id});
+                });
+                l->addWidget(row.position, 1);
+                this->sensors_layout->addWidget(row.widget);
+                this->sensor_rows[id] = row;
+            }
+            SensorRow &row = this->sensor_rows[id];
+            const double kpa = s.value("pressure_kpa").toDouble();
+            const int age = s.value("age_s").toInt();
+            row.label->setText(QString("%1%2\n%3 %4, %5, %6 dBm, %7")
+                                   .arg(id)
+                                   .arg(s.value("name").toString().isEmpty() ? QString() : "  " + s.value("name").toString())
+                                   .arg(metric ? QString::number(qRound(kpa)) : QString::number(kpa / 6.89476, 'f', 1))
+                                   .arg(metric ? "kPa" : "psi")
+                                   .arg(metric ? QString("%1 °C").arg(qRound(s.value("temp_c").toDouble()))
+                                               : QString("%1 °F").arg(qRound(s.value("temp_c").toDouble() * 9 / 5 + 32)))
+                                   .arg(s.value("rssi").toInt())
+                                   .arg(age < 60 ? QString("%1 s ago").arg(age) : QString("%1 min ago").arg(age / 60)));
+            this->loading = true;
+            row.position->set_current(label_for(kPositions, s.value("position").toString()));
+            this->loading = false;
+        }
+        for (auto it = this->sensor_rows.begin(); it != this->sensor_rows.end();) {
+            if (seen.contains(it.key())) {
+                ++it;
+                continue;
+            }
+            it->widget->deleteLater();
+            it = this->sensor_rows.erase(it);
+        }
+        this->no_sensors->setVisible(this->sensor_rows.isEmpty());
+    });
+}
