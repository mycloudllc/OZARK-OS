[Unit]
Description=Wi-Fi hotspot for wireless Android Auto
Requires=ozark-hotspot-setup.service
After=ozark-hotspot-setup.service
Wants=systemd-networkd.service
After=systemd-networkd.service

[Service]
ExecStart=/usr/sbin/ozark-hotspot run
# hostapd exits 0 when it cannot start the access point (e.g. the channel
# is not allowed yet): retry whatever the exit status
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
