+namespace {
+// Audio files the local player lists: what Ozark OS's GStreamer decodes
+// (meta-ozark opendash recipe; AAC/M4A would need gst-libav)
+const QStringList kAudioFiles = {"*.mp3", "*.flac", "*.ogg", "*.oga", "*.opus", "*.wav"};
+
+struct TrackTags {
+    QString title, artist, album;
+    QImage art;
+};
+
+// Title, artist, album and embedded cover art (any format TagLib reads)
+TrackTags read_tags(const QString &path, bool with_art)
+{
+    TrackTags tags;
+    TagLib::FileRef file(QFile::encodeName(path).constData());
+    if (!file.isNull() && file.tag()) {
+        tags.title = QString::fromStdString(file.tag()->title().to8Bit(true));
+        tags.artist = QString::fromStdString(file.tag()->artist().to8Bit(true));
+        tags.album = QString::fromStdString(file.tag()->album().to8Bit(true));
+    }
+    if (with_art && !file.isNull()) {
+        const auto pictures = file.complexProperties("PICTURE");
+        if (!pictures.isEmpty()) {
+            const TagLib::ByteVector data = pictures.front()["data"].toByteVector();
+            tags.art.loadFromData(reinterpret_cast<const uchar *>(data.data()), int(data.size()));
+        }
+    }
+    if (tags.title.isEmpty())
+        tags.title = QFileInfo(path).completeBaseName();
+    return tags;
+}
+}  // namespace
