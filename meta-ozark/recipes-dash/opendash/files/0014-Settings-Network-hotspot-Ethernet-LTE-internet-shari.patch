+
+    // Runs ozark-net; done(ok, message) gets stderr's last line on failure
+    void run(const QStringList &args, std::function<void(bool, const QString &)> done);
+    void refresh();
+    void show_status(const QMap<QString, QString> &status);
+    void fill_fields(const QMap<QString, QString> &status);
+    void set_busy(bool busy);
+    void report(bool ok, const QString &message);
