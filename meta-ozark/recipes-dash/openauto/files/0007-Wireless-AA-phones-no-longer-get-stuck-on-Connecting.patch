-    , socket_(nullptr)
     , config_(std::move(config))
 {
     connect(rfcommServer_.get(), &QBluetoothServer::newConnection, this, &AndroidBluetoothServer::onClientConnected);
@@ -60,20 +59,25 @@ bool AndroidBluetoothServer::start(const QBluetoothAddress& address, uint16_t po
 
 void AndroidBluetoothServer::onClientConnected()
 {
-    socket_ = rfcommServer_->nextPendingConnection();
-    if(socket_ != nullptr)
+    // Each phone gets its own handshake. One socket for all of them meant a
+    // second phone (or the same phone reconnecting) took over the first's
+    // replies mid-handshake.
+    while(QBluetoothSocket* socket = rfcommServer_->nextPendingConnection())
     {
-        OPENAUTO_LOG(info) << "[AndroidBluetoothServer] Device Connected: " << socket_->peerName().toStdString();
-        connect(socket_, SIGNAL(readyRead()), this, SLOT(readSocket()));
-        writeSocketInfoRequest();
-    }
-    else
-    {
-        OPENAUTO_LOG(error) << "[AndroidBluetoothServer] received null socket during client connection.";
+        OPENAUTO_LOG(info) << "[AndroidBluetoothServer] Device Connected: " << socket->peerName().toStdString()
+                           << " (" << socket->peerAddress().toString().toStdString() << ")";
+        sockets_.insert(socket, QByteArray());
+        connect(socket, &QBluetoothSocket::readyRead, this, &AndroidBluetoothServer::readSocket);
+        connect(socket, &QBluetoothSocket::disconnected, this, [this, socket]() {
+            OPENAUTO_LOG(info) << "[AndroidBluetoothServer] Device Disconnected: " << socket->peerName().toStdString();
+            sockets_.remove(socket);
+            socket->deleteLater();
+        });
+        writeSocketInfoRequest(socket);
     }
 }
 
