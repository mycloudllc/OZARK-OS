diff --git a/include/app/services/vehicle_client.hpp b/include/app/services/vehicle_client.hpp
new file mode 100644
index 0000000..15066e1
--- /dev/null
+++ b/include/app/services/vehicle_client.hpp
@@ -0,0 +1,54 @@
+#pragma once
+
+#include <functional>
+
+#include <QtDBus>
+
+// The vehicle service (ozark-vehicled, org.ozark.Vehicle1): OBD-II values and
+// trouble codes, the illumination input, tire pressures. One per Dash, shared
+// by the Vehicle page and Settings > Vehicle. Keeps the latest of everything,
+// and picks it all up again when the service (re)starts.
+class VehicleClient : public QObject {
+    Q_OBJECT
+
+   public:
+    static VehicleClient &instance();
+
+    // Async call; `done` gets the reply's arguments, unwrapped from D-Bus
+    // types into plain QVariantMap/QVariantList (on error, never called)
+    void call(const QString &method, const QVariantList &args = {},
+              std::function<void(const QVariantList &)> done = nullptr);
+    void refresh();
+
+    QVariantMap status;    // GetStatus
+    QVariantMap values;    // GetValues
+    QVariantMap tires;     // GetTires
+    QVariantMap dtcs;      // the last trouble code read
+    bool illumination = false;
+    bool running = false;  // the service is there
+
+    // Nested D-Bus maps and lists arrive as QDBusArgument: make them plain
+    static QVariant unwrap(const QVariant &value);
+
+   signals:
+    void status_changed();
+    void values_changed();
+    void tires_changed();
+    void dtcs_read(const QVariantMap &result);
+    void dtcs_cleared(bool ok, const QString &message);
+    void illumination_changed(bool on);
+    void config_changed(const QVariantMap &config);
+
+   private slots:
+    void on_status(const QDBusMessage &message);
+    void on_values(const QDBusMessage &message);
+    void on_tires(const QDBusMessage &message);
+    void on_dtcs(const QDBusMessage &message);
+    void on_cleared(bool ok, const QString &message);
+    void on_illumination(bool on);
+    void on_config(const QDBusMessage &message);
+
+   private:
+    VehicleClient();
+    QDBusServiceWatcher *watcher;
+};
