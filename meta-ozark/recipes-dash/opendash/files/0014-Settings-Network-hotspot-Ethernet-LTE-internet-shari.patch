diff --git a/src/app/widgets/text_entry.cpp b/src/app/widgets/text_entry.cpp
new file mode 100644
index 0000000..47f9033
--- /dev/null
+++ b/src/app/widgets/text_entry.cpp
@@ -0,0 +1,139 @@
+#include "app/arbiter.hpp"
+#include "app/widgets/dialog.hpp"
+
+#include "app/widgets/text_entry.hpp"
+
+namespace {
+const QList<QString> kLetters = {"1234567890", "qwertyuiop", "asdfghjkl", "zxcvbnm"};
+// The last row leaves room for shift (letters) and backspace: 8 keys at most
+const QList<QString> kSymbols = {"1234567890", "@#$%&*-+()", "!\"':;/?_=", ",~[]{}<>"};
+}  // namespace
+
+Keyboard::Keyboard(Arbiter &arbiter, QLineEdit *target, bool numbers_first, QWidget *parent)
+    : QWidget(parent)
+    , arbiter(arbiter)
+    , target(target)
+    , grid(new QGridLayout(this))
+    , symbols(numbers_first)
+{
+    this->grid->setContentsMargins(0, 8, 0, 0);
+    this->grid->setSpacing(4);
+    this->build();
+}
+
+void Keyboard::build()
+{
+    while (QLayoutItem *item = this->grid->takeAt(0)) {
+        delete item->widget();
+        delete item;
+    }
+
+    const QFont font = this->arbiter.forge().font(14);
+    auto key = [this, font](const QString &label, int row, int col, int span, std::function<void()> action) {
+        auto button = new QPushButton(label, this);
+        button->setFont(font);
+        button->setMinimumSize(56, 48);
+        button->setFocusPolicy(Qt::NoFocus);
+        connect(button, &QPushButton::clicked, action);
+        this->grid->addWidget(button, row, col, 1, span);
+    };
+
+    // Each row centred on a 20-column grid; a key spans two columns
+    const QList<QString> &rows = this->symbols ? kSymbols : kLetters;
+    for (int r = 0; r < rows.size(); r++) {
+        const QString &chars = rows[r];
+        int col = 10 - chars.size();
+        if (r == 3 && !this->symbols) {
+            key(this->shift ? "SHIFT" : "shift", r, 0, 3, [this] {
+                this->shift = !this->shift;
+                this->build();
+            });
+            col = 3;
+        }
+        for (QChar c : chars) {
+            const QString text = (this->shift && !this->symbols) ? QString(c).toUpper() : QString(c);
+            key(text == "&" ? "&&" : text, r, col, 2, [this, text] { this->type(text); });
+            col += 2;
+        }
+        if (r == 3)
+            key("⌫", r, 17, 3, [this] { this->target->backspace(); });
+    }
+    key(this->symbols ? "abc" : "?123", 4, 0, 4, [this] {
+        this->symbols = !this->symbols;
+        this->build();
+    });
+    key("space", 4, 4, 12, [this] { this->type(" "); });
+    key(".", 4, 16, 4, [this] { this->type("."); });
+}
+
+void Keyboard::type(const QString &text)
+{
+    this->target->insert(text);
+    if (this->shift) {
+        this->shift = false;
+        this->build();
+    }
+}
+
+TextEntry::TextEntry(Arbiter &arbiter, const QString &title, Kind kind, QWidget *parent)
+    : QPushButton(parent)
+    , arbiter(arbiter)
+    , title(title)
+    , kind(kind)
+{
+    this->setFont(arbiter.forge().font(14));
+    connect(this, &QPushButton::clicked, [this] { this->open_editor(); });
+    this->update_text();
+}
+
+void TextEntry::set_value(const QString &value)
+{
+    this->value_ = value;
+    this->update_text();
+}
+
+void TextEntry::set_placeholder(const QString &placeholder)
+{
+    this->placeholder = placeholder;
+    this->update_text();
+}
+
+void TextEntry::update_text()
+{
+    if (this->value_.isEmpty())
+        this->setText(this->placeholder.isEmpty() ? "tap to set" : this->placeholder);
+    else if (this->kind == Password)
+        this->setText(QString(this->value_.size(), QChar(0x2022)));
+    else
+        this->setText(this->value_);
+}
+
+void TextEntry::open_editor()
+{
+    auto dialog = new Dialog(this->arbiter, true, this->arbiter.window());
+    dialog->setAttribute(Qt::WA_DeleteOnClose);
+    dialog->set_title(this->title);
+
+    auto body = new QWidget(dialog);
+    auto layout = new QVBoxLayout(body);
+    layout->setContentsMargins(0, 8, 0, 0);
+    // The person editing is the owner: show what they type, passwords too
+    auto line = new QLineEdit(this->value_, body);
+    line->setFont(this->arbiter.forge().font(16));
+    line->setMinimumHeight(48);
+    line->setStyleSheet("QLineEdit { background-color: palette(window); color: palette(text); "
+                        "border: 1px solid palette(mid); border-radius: 4px; padding: 0 8px; }");
+    layout->addWidget(line);
+    layout->addWidget(new Keyboard(this->arbiter, line, this->kind == Number, body));
+    dialog->set_body(body);
+
+    auto done = new QPushButton("done");
+    connect(done, &QPushButton::clicked, [this, line] {
+        this->set_value(line->text().trimmed());
+        emit edited(this->value_);
+    });
+    dialog->set_button(done);
+    dialog->open();
+    line->setFocus();
+    line->end(false);
+}
