diff --git a/include/app/widgets/touch_input.hpp b/include/app/widgets/touch_input.hpp
new file mode 100644
index 0000000..c70895f
--- /dev/null
+++ b/include/app/widgets/touch_input.hpp
@@ -0,0 +1,31 @@
+#pragma once
+
+#include <QObject>
+#include <QPointer>
+
+class Arbiter;
+class QDialog;
+class QLineEdit;
+
+// Makes ordinary Qt widgets, the kind plugins use, work on a touchscreen with
+// no keyboard or window manager. Installed on the application:
+// - tapping an editable text box opens the on-screen keyboard for it;
+// - a plain dialog (not one of Dash's own) is sized to fit its contents and
+//   centred on the screen, instead of Qt's default of at most 2/3 of the
+//   screen, which clipped their contents and pushed tall ones to the top.
+class TouchInput : public QObject {
+    Q_OBJECT
+
+   public:
+    TouchInput(Arbiter &arbiter, QObject *parent = nullptr);
+
+   protected:
+    bool eventFilter(QObject *watched, QEvent *event) override;
+
+   private:
+    void edit(QLineEdit *line);
+    void fit(QDialog *dialog);
+
+    Arbiter &arbiter;
+    QPointer<QLineEdit> editing;
+};
