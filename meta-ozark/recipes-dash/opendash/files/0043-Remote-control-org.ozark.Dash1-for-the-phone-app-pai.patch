+#pragma once
+
+#include <QDBusContext>
+#include <QObject>
+#include <QPointer>
+#include <QTimer>
+#include <QVariantMap>
+
+class Arbiter;
+class Dialog;
+class QLabel;
+
+// org.ozark.Dash1 on the system bus: what ozark-remoted (the phone app)
+// controls in Dash. GetState() and StateChanged give volume, brightness,
+// theme, page and media; Control(method, params) runs one of the remote
+// protocol's dash.*, media.* and radio.* methods (remote/PROTOCOL.md).
+// Also puts ozark-remoted's pairing code on the screen.
+class DashRemote : public QObject, protected QDBusContext {
+    Q_OBJECT
+    Q_CLASSINFO("D-Bus Interface", "org.ozark.Dash1")
+
+   public:
+    DashRemote(Arbiter &arbiter, QObject *parent = nullptr);
+
+   public slots:
+    Q_SCRIPTABLE QVariantMap GetState() const;
+    Q_SCRIPTABLE QVariantMap Control(const QString &method, const QVariantMap &params);
+
+   signals:
+    Q_SCRIPTABLE void StateChanged(const QVariantMap &state);
+
+   private slots:
+    void on_pairing_started(const QString &code, const QString &name, int seconds);
+    void on_pairing_ended(const QString &name, bool paired);
+
+   private:
+    Arbiter &arbiter;
+    QTimer coalesce;
+    QPointer<Dialog> pairing;
+    QLabel *countdown = nullptr;
+    int seconds_left = 0;
+    QTimer ticker;
+
+    QVariantMap fail(const QString &message);
+};
