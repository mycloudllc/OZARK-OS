+#pragma once
+
+#include <QtWidgets>
+
+class Arbiter;
+
+// On-screen keyboard that types into a line edit: letters (with shift) and a
+// numbers/symbols layer, for touchscreens without a physical keyboard.
+class Keyboard : public QWidget {
+    Q_OBJECT
+
+   public:
+    Keyboard(Arbiter &arbiter, QLineEdit *target, bool numbers_first = false, QWidget *parent = nullptr);
+
+   private:
+    void build();
+    void type(const QString &text);
+
+    Arbiter &arbiter;
+    QLineEdit *target;
+    QGridLayout *grid;
+    bool symbols;
+    bool shift = false;
+};
+
+// A setting typed in on the touchscreen. Shows the value (dots for a
+// password); tapping it opens a dialog with a Keyboard. edited() fires when
+// the user taps "done".
+class TextEntry : public QPushButton {
+    Q_OBJECT
+
+   public:
+    enum Kind { Text, Password, Number };
+
+    TextEntry(Arbiter &arbiter, const QString &title, Kind kind = Text, QWidget *parent = nullptr);
+
+    QString value() const { return this->value_; }
+    void set_value(const QString &value);
+    void set_placeholder(const QString &placeholder);
+
+   signals:
+    void edited(const QString &value);
+
+   private:
+    void open_editor();
+    void update_text();
+
+    Arbiter &arbiter;
+    QString title;
+    Kind kind;
+    QString value_;
+    QString placeholder;
+};
diff --git a/src/app/pages/network_settings.cpp b/src/app/pages/network_settings.cpp
