+void Bluetooth::set_adapter(BluezQt::AdapterPtr adapter)
+{
+    if (adapter == this->adapter)
+        return;
+
+    if (this->has_adapter())
+        this->adapter->disconnect(this);
+    this->adapter = adapter;
+    this->stop_reconnecting();
+    if (!this->has_adapter())
+        return;
+
+    DASH_LOG(info) << "[Bluetooth] Adapter " << adapter->address().toStdString();
+
+    // Pages made before BlueZ was ready show "nothing playing": tell them
+    for (auto device : this->get_devices()) {
+        if (device->mediaPlayer() != nullptr) {
+            this->update_media_player(device);
+            break;
+        }
+    }
+
+    connect(this->adapter.data(), &BluezQt::Adapter::deviceAdded, this, [this](BluezQt::DevicePtr device){
+        emit device_added(device);
+    });
+    connect(this->adapter.data(), &BluezQt::Adapter::deviceChanged, this, [this](BluezQt::DevicePtr device) {
+        emit device_changed(device);
+        this->update_media_player(device);
+        this->remember_phone(device);
+    });
+    connect(this->adapter.data(), &BluezQt::Adapter::deviceRemoved, this, [this](BluezQt::DevicePtr device){
+        emit device_removed(device);
+    });
+
+    this->reconnect_attempts = 0;
+    this->reconnect_timer->start(3000);
+}
+
+void Bluetooth::remember_phone(BluezQt::DevicePtr device)
+{
+    if (!device->isConnected() || !device->isPaired() || device->type() != BluezQt::Device::Phone)
+        return;
+
+    // A phone is here: no need to call one
+    this->stop_reconnecting();
+
+    auto config = Config::get_instance()->openauto_config;
+    const std::string address = device->address().toUpper().toStdString();
+    if (QString::fromStdString(config->getLastBluetoothPair()).toUpper().toStdString() == address)
+        return;
+
+    DASH_LOG(info) << "[Bluetooth] Last phone is now " << device->name().toStdString() << " (" << address << ")";
+    config->setLastBluetoothPair(address);
+    config->save();
+}
+
+void Bluetooth::stop_reconnecting()
+{
+    this->reconnect_timer->stop();
+    this->reconnect_attempts = 0;
+}
+
+void Bluetooth::reconnect_last_phone()
+{
+    if (!this->has_adapter() || this->reconnect_pending)
+        return;
+
+    auto config = Config::get_instance()->openauto_config;
+    if (!config->getAutoconnectBluetooth())
+        return;
+
+    for (auto device : this->get_devices()) {
+        if (device->isConnected() && device->isPaired() && device->type() == BluezQt::Device::Phone) {
+            this->remember_phone(device);
+            return;
+        }
+    }
+
+    const QString address = QString::fromStdString(config->getLastBluetoothPair()).toUpper();
+    if (address.isEmpty()) {
+        DASH_LOG(info) << "[Bluetooth] No last phone to reconnect yet";
+        return;
+    }
+    BluezQt::DevicePtr device = this->adapter->deviceForAddress(address);
+    if (device == nullptr || !device->isPaired()) {
+        DASH_LOG(info) << "[Bluetooth] Last phone " << address.toStdString() << " is no longer paired";
+        return;
+    }
+
+    // Every 10 s for the first two minutes (the phone's Bluetooth may still be
+    // starting, or it's on the way to the car), then every minute
+    ++this->reconnect_attempts;
+    const int next = (this->reconnect_attempts < 12) ? 10000 : 60000;
+    if (this->reconnect_attempts == 1 || this->reconnect_attempts % 10 == 0)
+        DASH_LOG(info) << "[Bluetooth] Reconnecting " << device->name().toStdString() << " (" << address.toStdString()
+                       << "), attempt " << this->reconnect_attempts;
+
+    this->reconnect_pending = true;
+    BluezQt::PendingCall *call = device->connectToDevice();
+    connect(call, &BluezQt::PendingCall::finished, this, [this, device, next](BluezQt::PendingCall *call){
+        this->reconnect_pending = false;
+        if (!call->error() || call->error() == BluezQt::PendingCall::AlreadyConnected) {
+            DASH_LOG(info) << "[Bluetooth] Reconnected " << device->name().toStdString();
+            this->remember_phone(device);
+            this->stop_reconnecting();
+            return;
+        }
+        if (this->reconnect_attempts == 1)
+            DASH_LOG(info) << "[Bluetooth] Phone not reachable yet (" << call->errorText().toStdString() << "), trying again";
+        // stop_reconnecting() may have run meanwhile (a phone connected)
+        if (this->reconnect_attempts > 0)
+            this->reconnect_timer->start(next);
+    });
+}
