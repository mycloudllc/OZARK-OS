diff --git a/src/app/md3.cpp b/src/app/md3.cpp
new file mode 100644
index 0000000..3cd77f9
--- /dev/null
+++ b/src/app/md3.cpp
@@ -0,0 +1,148 @@
+#include "app/md3.hpp"
+
+#include <QRegularExpression>
+
+#include <cmath>
+
+namespace {
+// A tone (0 black - 100 white) of a hue at a saturation
+QColor tone(double hue, double saturation, double t)
+{
+    return QColor::fromHslF(hue, qBound(0.0, saturation, 1.0), qBound(0.0, t / 100.0, 1.0));
+}
+}  // namespace
+
+Md3 Md3::scheme(const QColor &seed, bool dark)
+{
+    // Dash's default theme colours are plain black and white: use M3's
+    // baseline blue then
+    double h = seed.hslHueF(), s = seed.hslSaturationF();
+    if (h < 0 || s < 0.15 || seed.lightnessF() < 0.08 || seed.lightnessF() > 0.95) {
+        h = 217 / 360.0;
+        s = 0.75;
+    }
+    const double ps = qBound(0.45, s, 0.9);  // primary
+    const double ss = ps * 0.3;              // secondary: same hue, muted
+    const double th = std::fmod(h + 60 / 360.0, 1.0), ts = ps * 0.5;  // tertiary: a neighbour
+    const double ns = 0.05, nvs = 0.1;       // neutral, neutral variant: a hint of the hue
+
+    Md3 m;
+    if (dark) {
+        m.primary = tone(h, ps, 80);
+        m.on_primary = tone(h, ps, 20);
+        m.primary_container = tone(h, ps, 30);
+        m.on_primary_container = tone(h, ps, 90);
+        m.secondary = tone(h, ss, 80);
+        m.on_secondary = tone(h, ss, 20);
+        m.secondary_container = tone(h, ss, 30);
+        m.on_secondary_container = tone(h, ss, 90);
+        m.tertiary_container = tone(th, ts, 30);
+        m.on_tertiary_container = tone(th, ts, 90);
+        m.error = QColor("#f2b8b5");
+        m.on_error = QColor("#601410");
+        m.error_container = QColor("#8c1d18");
+        m.on_error_container = QColor("#f9dedc");
+        m.surface = tone(h, ns, 6);
+        m.surface_dim = tone(h, ns, 6);
+        m.surface_container_lowest = tone(h, ns, 4);
+        m.surface_container_low = tone(h, ns, 10);
+        m.surface_container = tone(h, ns, 12);
+        m.surface_container_high = tone(h, ns, 17);
+        m.surface_container_highest = tone(h, ns, 22);
+        m.on_surface = tone(h, ns, 90);
+        m.on_surface_variant = tone(h, nvs, 80);
+        m.outline = tone(h, nvs, 60);
+        m.outline_variant = tone(h, nvs, 30);
+        m.inverse_surface = tone(h, ns, 90);
+        m.inverse_on_surface = tone(h, ns, 20);
+        m.inverse_primary = tone(h, ps, 40);
+    } else {
+        m.primary = tone(h, ps, 40);
+        m.on_primary = tone(h, ps, 100);
+        m.primary_container = tone(h, ps, 90);
+        m.on_primary_container = tone(h, ps, 10);
+        m.secondary = tone(h, ss, 40);
+        m.on_secondary = tone(h, ss, 100);
+        m.secondary_container = tone(h, ss, 90);
+        m.on_secondary_container = tone(h, ss, 10);
+        m.tertiary_container = tone(th, ts, 90);
+        m.on_tertiary_container = tone(th, ts, 10);
+        m.error = QColor("#b3261e");
+        m.on_error = QColor("#ffffff");
+        m.error_container = QColor("#f9dedc");
+        m.on_error_container = QColor("#410e0b");
+        m.surface = tone(h, ns, 98);
+        m.surface_dim = tone(h, ns, 87);
+        m.surface_container_lowest = tone(h, ns, 100);
+        m.surface_container_low = tone(h, ns, 96);
+        m.surface_container = tone(h, ns, 94);
+        m.surface_container_high = tone(h, ns, 92);
+        m.surface_container_highest = tone(h, ns, 90);
+        m.on_surface = tone(h, ns, 10);
+        m.on_surface_variant = tone(h, nvs, 30);
+        m.outline = tone(h, nvs, 50);
+        m.outline_variant = tone(h, nvs, 80);
+        m.inverse_surface = tone(h, ns, 20);
+        m.inverse_on_surface = tone(h, ns, 95);
+        m.inverse_primary = tone(h, ps, 80);
+    }
+    return m;
+}
+
+QMap<QString, QColor> Md3::roles() const
+{
+    return {
+        {"primary", primary},
+        {"on-primary", on_primary},
+        {"primary-container", primary_container},
+        {"on-primary-container", on_primary_container},
+        {"secondary", secondary},
+        {"on-secondary", on_secondary},
+        {"secondary-container", secondary_container},
+        {"on-secondary-container", on_secondary_container},
+        {"tertiary-container", tertiary_container},
+        {"on-tertiary-container", on_tertiary_container},
+        {"error", error},
+        {"on-error", on_error},
+        {"error-container", error_container},
+        {"on-error-container", on_error_container},
+        {"surface", surface},
+        {"surface-dim", surface_dim},
+        {"surface-container-lowest", surface_container_lowest},
+        {"surface-container-low", surface_container_low},
+        {"surface-container", surface_container},
+        {"surface-container-high", surface_container_high},
+        {"surface-container-highest", surface_container_highest},
+        {"on-surface", on_surface},
+        {"on-surface-variant", on_surface_variant},
+        {"outline", outline},
+        {"outline-variant", outline_variant},
+        {"inverse-surface", inverse_surface},
+        {"inverse-on-surface", inverse_on_surface},
+        {"inverse-primary", inverse_primary},
+    };
+}
+
+QString Md3::apply(const QString &stylesheet) const
+{
+    static const QRegularExpression token("@md-([a-z-]+[a-z])(?:/(\\d{1,3}))?");
+    const QMap<QString, QColor> colors = this->roles();
+    QString out;
+    out.reserve(stylesheet.size());
+    int last = 0;
+    auto it = token.globalMatch(stylesheet);
+    while (it.hasNext()) {
+        const auto match = it.next();
+        out += stylesheet.midRef(last, match.capturedStart() - last);
+        last = match.capturedEnd();
+        const auto c = colors.find(match.captured(1));
+        if (c == colors.end()) {
+            out += match.captured();  // unknown role: leave it for Qt to complain about
+            continue;
+        }
+        const int alpha = match.captured(2).isEmpty() ? 255 : qBound(0, match.captured(2).toInt(), 100) * 255 / 100;
+        out += QString("rgba(%1, %2, %3, %4)").arg(c->red()).arg(c->green()).arg(c->blue()).arg(alpha);
+    }
+    out += stylesheet.midRef(last);
+    return out;
+}
