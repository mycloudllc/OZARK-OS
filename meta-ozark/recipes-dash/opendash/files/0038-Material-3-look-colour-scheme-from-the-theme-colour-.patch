new file mode 100644
index 0000000..fa9021f
--- /dev/null
+++ b/include/app/md3.hpp
@@ -0,0 +1,31 @@
+#pragma once
+
+#include <QColor>
+#include <QMap>
+#include <QString>
+
+// A Material 3 colour scheme, made from one seed colour (the theme colour
+// picked in Settings) for light or dark mode: the roles the M3 guidelines
+// use (primary, containers, surfaces, outlines...). Tones are approximated in
+// HSL rather than M3's HCT, close enough for a head unit.
+//
+// Stylesheets use the roles as @md-<role> (e.g. @md-primary,
+// @md-surface-container-high), optionally with an opacity in percent for
+// state layers: @md-on-surface/12.
+struct Md3 {
+    QColor primary, on_primary, primary_container, on_primary_container;
+    QColor secondary, on_secondary, secondary_container, on_secondary_container;
+    QColor tertiary_container, on_tertiary_container;
+    QColor error, on_error, error_container, on_error_container;
+    QColor surface, surface_dim, surface_container_lowest, surface_container_low, surface_container,
+        surface_container_high, surface_container_highest;
+    QColor on_surface, on_surface_variant, outline, outline_variant;
+    QColor inverse_surface, inverse_on_surface, inverse_primary;
+
+    static Md3 scheme(const QColor &seed, bool dark);
+
+    // Every role by its stylesheet name ("primary", "on-surface-variant", ...)
+    QMap<QString, QColor> roles() const;
+    // Replace @md-<role>[/<opacity>] in a stylesheet
+    QString apply(const QString &stylesheet) const;
+};
