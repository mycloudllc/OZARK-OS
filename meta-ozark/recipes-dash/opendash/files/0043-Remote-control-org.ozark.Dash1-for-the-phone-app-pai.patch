+#pragma once
+
+#include <QObject>
+#include <QVariantMap>
+
+// Where the media tabs meet the remote control (org.ozark.Dash1, the phone
+// app): each tab reports what it's playing, and acts on requests for it.
+// Sources: "radio", "bluetooth" (the phone's music, or Android Auto's), "local".
+class MediaRemote : public QObject {
+    Q_OBJECT
+
+   public:
+    static MediaRemote &instance();
+
+    // Merges into the source's state: available, playing, title, artist,
+    // album, position_ms, duration_ms, ... (radio: band, freq_hz, label, presets)
+    void report(const QString &source, const QVariantMap &state);
+    QVariantMap state() const;
+    QVariantMap state(const QString &source) const { return this->sources.value(source).toMap(); }
+    // The source that played last: where play/pause/next go without a source
+    QString active() const { return this->active_; }
+    void set_active(const QString &source);
+
+   signals:
+    // For the tab that is `source`
+    void request(const QString &source, const QString &action, const QVariantMap &params);
+    // Show that source's tab on the Media page
+    void show(const QString &source);
+    void changed();
+
+   private:
+    MediaRemote() = default;
+    QVariantMap sources;
+    QString active_ = "radio";
+};
