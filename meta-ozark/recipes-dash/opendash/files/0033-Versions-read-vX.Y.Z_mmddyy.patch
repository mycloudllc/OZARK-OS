From 5c5876071abe2c296f05545b63905a57d0b79c74 Mon Sep 17 00:00:00 2001
From: Ozark <ozark@localhost>
Date: Sun, 15 Nov 2026 18:53:36 -0600
Subject: [PATCH] Versions read vX.Y.Z_mmddyy

Every version on the Update page (this one, the one available, the one
installed or tried, the one updated from) and on the About page now
reads like "v0.2.0_111626": the version and its build date, from the
build stamp. Without a stamp it's just "v0.2.0". "Updated from" uses
the previous build's stamp, which ozark-update now records
(state.from_build).

Upstream-Status: Inappropriate [Ozark OS behaviour]
---
 include/app/pages/update_settings.hpp |  4 +++
 src/app/pages/settings.cpp            | 24 +++++++++++++-----
 src/app/pages/update_settings.cpp     | 35 +++++++++++++++------------
 3 files changed, 41 insertions(+), 22 deletions(-)

diff --git a/include/app/pages/update_settings.hpp b/include/app/pages/update_settings.hpp
index 6583c1b..7b07ce5 100644
--- a/include/app/pages/update_settings.hpp
+++ b/include/app/pages/update_settings.hpp
@@ -5,6 +5,10 @@
 #include <QMap>
 #include <QtWidgets>
 
+// How a version shows: "v0.2.0_111626", the version and its build date
+// (mmddyy) from a build stamp (YYYYMMDDHHMMSS); just "v0.2.0" without one
+QString ozark_version(const QString &version, const QString &build);
+
 class Arbiter;
 class Dialog;
 class Selector;
diff --git a/src/app/pages/settings.cpp b/src/app/pages/settings.cpp
index 7eb09e0..e86c228 100644
--- a/src/app/pages/settings.cpp
+++ b/src/app/pages/settings.cpp
@@ -665,20 +665,32 @@ void AboutSettingsTab::resizeEvent(QResizeEvent *event)
 }
 
 namespace {
-// PRETTY_NAME from os-release, e.g. "Ozark OS 0.1.0 (trailhead)"
-QString os_name()
+// KEY=value (quotes dropped) from the first of these files that has it
+QString read_value(const QStringList &paths, const QString &key)
 {
-    for (const QString &path : {QString("/etc/os-release"), QString("/usr/lib/os-release")}) {
+    for (const QString &path : paths) {
         QFile file(path);
         if (!file.open(QFile::ReadOnly | QFile::Text))
             continue;
         while (!file.atEnd()) {
             const QString line = QString::fromUtf8(file.readLine()).trimmed();
-            if (line.startsWith("PRETTY_NAME="))
-                return line.mid(12).remove('"');
+            if (line.startsWith(key + "="))
+                return line.mid(key.size() + 1).remove('"');
         }
     }
-    return "Ozark OS";
+    return QString();
+}
+
+// "Ozark OS v0.2.0_111626": NAME and VERSION_ID from os-release, and the
+// build stamp from /etc/ozark-build
+QString os_name()
+{
+    const QStringList release{"/etc/os-release", "/usr/lib/os-release"};
+    QString name = read_value(release, "NAME");
+    if (name.isEmpty())
+        name = "Ozark OS";
+    const QString version = ozark_version(read_value(release, "VERSION_ID"), read_value({"/etc/ozark-build"}, "BUILD"));
+    return version.isEmpty() ? name : name + " " + version;
 }
 }  // namespace
 
