+// Full-screen dialogs stay inside their area, with a margin
+void Dialog::constrain()
+{
+    if (!this->fullscreen)
+        return;
+    if (QWidget *parent = this->area()) {
+        int margin = std::ceil(24 * this->arbiter.layout().scale) * 2;
+        this->setFixedWidth(std::min(this->width(), parent->width() - margin));
+        this->setFixedHeight(std::min(this->height(), parent->height() - margin));
+    }
 }
 
