-void AndroidBluetoothServer::handleUnknownMessage(int messageType, QByteArray data)
+void AndroidBluetoothServer::handleUnknownMessage(int messageType, const QByteArray& data)
 {
         OPENAUTO_LOG(info) << "[AndroidBluetoothServer] Received unknown MessageType of "<<messageType;
         OPENAUTO_LOG(info) << "[AndroidBluetoothServer] Unknown Message Data: "<<data.toHex(' ').toStdString()  ;
@@ -210,32 +212,45 @@ void AndroidBluetoothServer::handleUnknownMessage(int messageType, QByteArray da
 
 void AndroidBluetoothServer::readSocket()
 {
-    if(!socket_)
+    auto socket = qobject_cast<QBluetoothSocket*>(sender());
+    if(socket == nullptr || !sockets_.contains(socket))
     {
         return;
     }
 
-    auto data = socket_->readAll();
-    if(data.length() == 0)
+    // Messages are [length:2][type:2][payload:length], big-endian. Take every
+    // whole one; keep a partial one for the next read.
+    QByteArray& buffer = sockets_[socket];
+    buffer.append(socket->readAll());
+    while(buffer.size() >= 4)
     {
-        return;
+        const auto byte = [&buffer](int i) { return static_cast<uint16_t>(static_cast<uint8_t>(buffer[i])); };
+        const uint16_t messageLength = (byte(0) << 8) | byte(1);
+        const uint16_t messageType = (byte(2) << 8) | byte(3);
+        if(buffer.size() < 4 + messageLength)
+        {
+            break;
+        }
+        const QByteArray payload = buffer.mid(4, messageLength);
+        buffer.remove(0, 4 + messageLength);
+        handleMessage(socket, messageType, payload);
     }
+}
 
-    uint16_t messageType = (data[2] << 8) | data[3];
+void AndroidBluetoothServer::handleMessage(QBluetoothSocket* socket, uint16_t messageType, const QByteArray& data)
+{
     switch(messageType)
     {
         case 1:
-            handleSocketInfoRequest(data);
+            handleSocketInfoRequest(socket, data);
             break;
         case 2:
-            writeNetworkInfoMessage();
+            writeNetworkInfoMessage(socket);
             break;
         case 7:
-            data.remove(0, 4);
-            handleSocketInfoRequestResponse(data);
+            handleSocketInfoRequestResponse(socket, data);
             break;
         default:
-            data.remove(0, 4);
             handleUnknownMessage(messageType, data);
             break;
     }
