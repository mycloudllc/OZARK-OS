+void TiresTab::update_tires()
+{
+    const QVariantMap tires = VehicleClient::instance().tires;
+    const bool si = Config::get_instance()->get_si_units();
+    this->empty->setVisible(tires.isEmpty());
+    for (auto it = this->tiles.begin(); it != this->tiles.end(); ++it) {
+        Tile &t = it.value();
+        const QVariantMap tire = tires.value(it.key()).toMap();
+        if (tire.isEmpty()) {
+            t.pressure->setText("--");
+            t.detail->setText("no sensor");
+            this->alert[it.key()] = false;
+            continue;
+        }
+        const bool low = tire.value("low").toBool(), hot = tire.value("hot").toBool();
+        t.pressure->setText(vehicle_units::pressure(tire.value("pressure_kpa").toDouble(), si));
+        QStringList detail;
+        detail << vehicle_units::pressure_unit(si) + ", " + vehicle_units::temp(tire.value("temp_c").toDouble(), si);
+        if (low)
+            detail << "low";
+        if (hot)
+            detail << "hot";
+        if (tire.contains("battery") && tire.value("battery").toInt() < 20)
+            detail << QString("battery %1%").arg(tire.value("battery").toInt());
+        const int age = tire.value("age_s").toInt();
+        if (age >= 120)
+            detail << (age < 7200 ? QString("%1 min ago").arg(age / 60) : QString("%1 h ago").arg(age / 3600));
+        if (tire.value("source").toString() == "hub")
+            detail << "hub";
+        t.detail->setText(detail.join(", "));
+        this->alert[it.key()] = low || hot;
+    }
+    this->trailer->setVisible(tires.contains("trailer_left") || tires.contains("trailer_right"));
+    this->restyle();
 }
