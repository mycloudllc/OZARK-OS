+void GaugesTab::update_values()
+{
+    const QVariantMap v = VehicleClient::instance().values;
+    const bool si = Config::get_instance()->get_si_units();
+    for (auto it = this->gauges.begin(); it != this->gauges.end(); ++it) {
+        const QString &key = it.key();
+        if (!v.contains(key)) {
+            it.value()->set_value(0, QString(), false);
+            continue;
+        }
+        double x = v.value(key).toDouble();
+        QString text;
+        if (key == "speed_kmh") {
+            x = si ? x : x * 0.621371;
+            text = QString::number(qRound(x));
+        } else if (key == "rpm") {
+            text = QLocale().toString(qRound(x));
+        } else if (key.endsWith("_c")) {
+            x = si ? x : x * 9 / 5 + 32;
+            text = QString::number(qRound(x));
+        } else if (key == "voltage_v") {
+            text = QString::number(x, 'f', 1);
+        } else {
+            text = QString::number(qRound(x));
+        }
+        it.value()->set_value(x, text);
+    }
