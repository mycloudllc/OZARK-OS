+        this->scroll->setWidget(widget);
 
-        this->body->addWidget(scroll_area);
+        this->body->addWidget(this->scroll);
     }
     else {
         this->body->addWidget(widget);
@@ -152,7 +174,7 @@ void Dialog::showEvent(QShowEvent *event)
 
