+#include "app/arbiter.hpp"
+#include "app/utilities/icon_engine.hpp"
+
+#include "app/widgets/now_playing.hpp"
+
+namespace {
+QString clock(qint64 ms)
+{
+    const qint64 s = std::max<qint64>(0, ms / 1000);
+    if (s >= 3600)
+        return QString("%1:%2:%3").arg(s / 3600).arg((s / 60) % 60, 2, 10, QChar('0')).arg(s % 60, 2, 10, QChar('0'));
+    return QString("%1:%2").arg(s / 60).arg(s % 60, 2, 10, QChar('0'));
+}
+}  // namespace
+
+AlbumArt::AlbumArt(Arbiter &arbiter, QWidget *parent)
+    : QWidget(parent)
+    , arbiter(arbiter)
+{
+    const int side = 220 * arbiter.layout().scale;
+    this->setFixedSize(side, side);  // NowPlaying resizes it to fit
+    connect(&arbiter, &Arbiter::mode_changed, this, [this]{ this->update(); });
+}
+
+void AlbumArt::set_art(const QImage &art)
+{
+    this->art = art;
+    this->update();
+}
+
+void AlbumArt::paintEvent(QPaintEvent *)
+{
+    QPainter painter(this);
+    painter.setRenderHint(QPainter::Antialiasing);
+    painter.setRenderHint(QPainter::SmoothPixmapTransform);
+    const QRectF frame = this->rect();
+    const qreal radius = 12 * this->arbiter.layout().scale;
+    QPainterPath path;
+    path.addRoundedRect(frame, radius, radius);
+    painter.setClipPath(path);
+
+    if (!this->art.isNull()) {
+        // fill the square, cropping the longer side
+        const QImage scaled = this->art.scaled(this->size(), Qt::KeepAspectRatioByExpanding, Qt::SmoothTransformation);
+        painter.drawImage(QPointF((this->width() - scaled.width()) / 2.0, (this->height() - scaled.height()) / 2.0), scaled);
+        return;
+    }
+
+    // placeholder: a soft tile with a music note (Dash's palette carries only
+    // the accent, so the tile's colour comes from the mode)
+    const bool dark = this->arbiter.theme().mode == Session::Theme::Dark;
+    const QColor tile = dark ? QColor(255, 255, 255, 26) : QColor(0, 0, 0, 20);
+    painter.fillPath(path, tile);
+    const int note = this->width() * 0.45;
+    QIcon icon(new IconEngine(this->arbiter, ":/icons/music_note.svg", false));
+    const QPixmap pixmap = icon.pixmap(note, note, QIcon::Disabled);
+    painter.drawPixmap((this->width() - note) / 2, (this->height() - note) / 2, pixmap);
+}
+
+NowPlaying::NowPlaying(Arbiter &arbiter, QWidget *parent)
+    : QWidget(parent)
+    , arbiter(arbiter)
+{
+    const double scale = arbiter.layout().scale;
+    auto layout = new QHBoxLayout(this);
+    layout->setSpacing(24 * scale);
+
+    this->art = new AlbumArt(arbiter, this);
+    layout->addWidget(this->art, 0, Qt::AlignVCenter);
+
+    auto right = new QVBoxLayout();
+    right->setSpacing(4 * scale);
+    right->addStretch(1);
+
+    this->source = new QLabel(this);
+    this->source->setFont(arbiter.forge().font(11));
+    this->source->setProperty("muted", true);
+    right->addWidget(this->source);
+
+    this->title = new QLabel(this);
+    QFont title_font = arbiter.forge().font(20);
+    title_font.setBold(true);
+    this->title->setFont(title_font);
+    right->addWidget(this->title);
+
+    this->artist = new QLabel(this);
+    this->artist->setFont(arbiter.forge().font(15));
+    right->addWidget(this->artist);
+
+    this->album = new QLabel(this);
+    this->album->setFont(arbiter.forge().font(12));
+    this->album->setProperty("muted", true);
+    right->addWidget(this->album);
+    right->addSpacing(12 * scale);
+
+    auto times = new QHBoxLayout();
+    this->elapsed = new QLabel(this);
+    this->elapsed->setFont(arbiter.forge().font(11));
+    this->progress = new QSlider(Qt::Horizontal, this);
+    this->progress->setTracking(false);
+    this->progress->setRange(0, 0);
+    this->total = new QLabel(this);
+    this->total->setFont(arbiter.forge().font(11));
+    times->addWidget(this->elapsed);
+    times->addWidget(this->progress, 1);
+    times->addWidget(this->total);
+    right->addLayout(times);
+    connect(this->progress, &QSlider::sliderMoved, [this](int position){ this->elapsed->setText(clock(position)); });
+    connect(this->progress, &QSlider::sliderReleased, [this]{ emit seek(this->progress->sliderPosition()); });
+
+    auto controls = new QHBoxLayout();
+    controls->setSpacing(24 * scale);
+    controls->addStretch(1);
+    auto prev = this->control("skip_previous", 40);
+    connect(prev, &QPushButton::clicked, [this]{ emit previous(); });
+    controls->addWidget(prev);
+
+    // The main control: a round button; its icon follows the playing state
+    this->play = new QPushButton(this);
+    const int side = 76 * scale;
+    this->play->setFixedSize(side, side);
+    this->play->setStyleSheet(QString("QPushButton { border-radius: %1px; padding: 0; }").arg(side / 2));
+    this->arbiter.forge().iconize("play", this->play, 40);
+    connect(this->play, &QPushButton::clicked, [this]{ emit play_pause(!this->playing); });
+    controls->addWidget(this->play);
+
+    auto nxt = this->control("skip_next", 40);
+    connect(nxt, &QPushButton::clicked, [this]{ emit next(); });
+    controls->addWidget(nxt);
+    controls->addStretch(1);
+    right->addLayout(controls);
+    right->addStretch(1);
+
+    layout->addLayout(right, 1);
+    this->set_position(0, 0);
+}
+
+QPushButton *NowPlaying::control(const QString &icon, int size)
+{
+    auto button = new QPushButton(this);
+    button->setFlat(true);
+    this->arbiter.forge().iconize(icon, button, size);
+    return button;
+}
+
+void NowPlaying::set_track(const QString &title, const QString &artist, const QString &album)
+{
+    this->title_text = title;
+    this->artist_text = artist;
+    this->album_text = album;
+    this->update_text();
+}
+
+void NowPlaying::set_source(const QString &source)
+{
+    this->source->setText(source);
+    this->source->setVisible(!source.isEmpty());
+}
+
+void NowPlaying::set_message(const QString &message, const QString &hint)
+{
+    this->message_text = message;
+    this->hint_text = hint;
+    this->update_text();
+}
+
+void NowPlaying::set_playing(bool playing)
+{
+    if (playing == this->playing)
+        return;
+    this->playing = playing;
+    this->arbiter.forge().iconize(playing ? "pause" : "play", this->play, 40);
+}
+
+void NowPlaying::set_position(qint64 position, qint64 duration)
+{
+    const bool known = duration > 0;
+    if (!this->progress->isSliderDown()) {
+        this->progress->setRange(0, known ? int(duration) : 0);
+        this->progress->setValue(int(std::min(position, std::max<qint64>(duration, 0))));
+        this->elapsed->setText(known ? clock(position) : QString());
+    }
+    this->total->setText(known ? clock(duration) : QString());
+}
+
+void NowPlaying::set_seekable(bool seekable)
+{
+    this->progress->setEnabled(seekable);
+}
+
+void NowPlaying::resizeEvent(QResizeEvent *event)
+{
+    QWidget::resizeEvent(event);
+    // Art: as tall as fits, but leave the text at least ~55% of the width
+    const int side = std::max(80, std::min(int(event->size().height() * 0.8), int(event->size().width() * 0.42)));
+    if (side != this->art->width())
+        this->art->setFixedSize(side, side);
+    this->update_text();
+}
+
+// Long names end in "…" rather than widening the layout
+void NowPlaying::update_text()
+{
+    const int width = std::max(100, this->width() - this->art->width() - int(48 * this->arbiter.layout().scale));
+    auto put = [width](QLabel *label, const QString &text) {
+        label->setText(label->fontMetrics().elidedText(text, Qt::ElideRight, width));
+        label->setVisible(!text.isEmpty());
+    };
+    const bool message = !this->message_text.isEmpty();
+    // A message (nothing playing) wraps; track details stay on one line each
+    for (QLabel *label : {this->title, this->artist})
+        label->setWordWrap(message);
+    if (message) {
+        this->title->setText(this->message_text);
+        this->artist->setText(this->hint_text);
+        this->title->setVisible(true);
+        this->artist->setVisible(!this->hint_text.isEmpty());
+        this->album->setVisible(false);
+        return;
+    }
+    put(this->title, this->title_text);
+    put(this->artist, this->artist_text);
