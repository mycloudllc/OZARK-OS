From 4efc4c31ec10d92a85c3fe3c057bc2eacba61485 Mon Sep 17 00:00:00 2001
From: Ozark <ozark@localhost>
Date: Wed, 28 Oct 2026 23:05:10 -0500
Subject: [PATCH 01/10] Cross-compile fixes for Yocto

- Find aasdk and openauto through the sysroot instead of ~/aasdk, ~/openauto
- Find TagLib through pkg-config: taglib-config can't run when cross-compiling
- Build with C++17 (TagLib 2 needs it) and link Protobuf's Abseil dependencies
- Quote CMAKE_EXE_LINKER_FLAGS when appending -rdynamic: unquoted, it becomes
  a list and every link gets a literal ';-rdynamic' once the toolchain sets
  linker flags (FindThreads then fails)

Upstream-Status: Inappropriate [Yocto Scarthgap toolchain specific]
---
 CMakeLists.txt                   |   4 +-
 cmake_modules/FindProtobuf.cmake |  11 +++
 cmake_modules/Findaasdk.cmake    |  50 +++--------
 cmake_modules/Findopenauto.cmake |  39 ++-------
 cmake_modules/Findtaglib.cmake   | 140 ++-----------------------------
 5 files changed, 41 insertions(+), 203 deletions(-)
 create mode 100644 cmake_modules/FindProtobuf.cmake

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 0750dc7..2cc034a 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -20,8 +20,8 @@ set(Boost_USE_MULTITHREADED ON)
 set(Boost_USE_STATIC_RUNTIME OFF)
 
 set(CMAKE_MODULE_PATH ${CMAKE_MODULE_PATH} "${CMAKE_SOURCE_DIR}/cmake_modules/")
-SET(CMAKE_CXX_STANDARD 14)
-set(CMAKE_EXE_LINKER_FLAGS ${CMAKE_EXE_LINKER_FLAGS} -rdynamic)
+SET(CMAKE_CXX_STANDARD 17)
+set(CMAKE_EXE_LINKER_FLAGS "${CMAKE_EXE_LINKER_FLAGS} -rdynamic")
 set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS_INIT} -Wall -pedantic -fPIC")
 set(CMAKE_CXX_FLAGS_DEBUG "-g -O0")
 set(CMAKE_CXX_FLAGS_RELEASE "-g -O3")
diff --git a/cmake_modules/FindProtobuf.cmake b/cmake_modules/FindProtobuf.cmake
new file mode 100644
index 0000000..b4d27ab
--- /dev/null
+++ b/cmake_modules/FindProtobuf.cmake
@@ -0,0 +1,11 @@
+# Protobuf 22+ (Yocto Scarthgap ships 4.25) splits its runtime into Abseil
+# libraries that CMake's stock FindProtobuf does not link. Keep the stock
+# module for protoc and protobuf_generate_cpp, and take the libraries from
+# protobuf.pc, which lists the Abseil dependencies.
+include(${CMAKE_ROOT}/Modules/FindProtobuf.cmake)
+
+find_package(PkgConfig REQUIRED)
+pkg_check_modules(PROTOBUF_PC REQUIRED IMPORTED_TARGET GLOBAL protobuf)
+
+set(Protobuf_LIBRARIES PkgConfig::PROTOBUF_PC)
+set(PROTOBUF_LIBRARIES PkgConfig::PROTOBUF_PC)
