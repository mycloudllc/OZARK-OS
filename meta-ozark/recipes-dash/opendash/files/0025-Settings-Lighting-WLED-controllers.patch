+
+// Show what applies to the controller in use
+void LightingSettingsTab::show_mode()
+{
+    const bool wled = this->status.value("type").toString() == "wled";
+    const QString link = this->status.value("link", "network").toString();
+    const bool network = link == "network";
+    const bool adalight = link == "adalight";
+    this->link_row->setVisible(wled);
+    this->baud_row->setVisible(wled && !network);
+    this->host_row->setVisible(wled && network);
+    this->find_row->setVisible(wled && network);
+    if (!(wled && network))
+        this->found_row->hide();
+    this->port_row->setVisible(!wled || !network);
+    this->wled_hint->setVisible(wled);
+    for (auto &strip : this->strips) {
+        strip.segment_row->setVisible(wled);
+        for (QWidget *row : strip.rows)
+            row->setVisible(!wled);
+    }
+    this->apply_button->setText(wled ? "apply" : "apply strip settings");
+
+    if (wled) {
+        const QString host = this->status.value("host").toString();
+        QString hint = QString("Set up the LEDs (pins, counts, segments) in WLED's own web page%1. "
+                               "Each zone here is one WLED segment.")
+                           .arg(network && !host.isEmpty() ? QString(", http://%1").arg(host) : QString());
+        if (!network)
+            hint += " USB speed must match WLED's serial baud rate (Config > Sync Interfaces).";
+        if (adalight)
+            hint += " With Adalight the head unit draws every LED and streams them, so the patterns, "
+                    "music included, look as on the Ozark controller. More LEDs need a higher speed "
+                    "for a smooth frame rate.";
+        else if (!network)
+            hint += " Music patterns follow the music over a network connection or Adalight; over "
+                    "USB they only react if the WLED board has its own microphone.";
+        else if (this->status.value("audio").toString() == "missing")
+            hint += " This WLED build has no AudioReactive usermod, so music patterns won't follow the "
+                    "music: install a WLED build that includes it.";
+        else
+            hint += " Music patterns use WLED's sound-reactive effects, fed with what's playing (audio sync).";
+        if (network)
+            hint += " On Wi-Fi, WLED needs the hotspot's 2.4 GHz band: a USB Wi-Fi adapter adds it.";
+        this->wled_hint->setText(hint);
+        this->strip_hint->setText("The test lights a segment red, green, then blue.");
+    }
+    else {
+        this->strip_hint->setText("The test lights a strip red, green, then blue from start to end. "
+                                  "If the colors are wrong, change the color order and apply.");
+    }
+}
+
+void LightingSettingsTab::on_wled_found(const QStringList &found)
+{
+    this->find->setEnabled(true);
+    this->find->setText("find");
+    this->found_hosts.clear();
+    QList<QString> options;
+    for (const QString &entry : found) {
+        const QString address = entry.section(' ', 0, 0);
+        this->found_hosts.append(address);
+        options.append(QString("%1 (%2)").arg(entry.section(' ', 1), address));
+    }
+    if (options.isEmpty()) {
+        this->found_row->hide();
+        this->result->setText("No WLED found. Is it on the hotspot or Ethernet?");
+        return;
+    }
+    this->result->clear();
+    this->loading = true;
+    this->found->set_options(options);
+    const int current = this->found_hosts.indexOf(this->status.value("host").toString());
+    if (current >= 0)
+        this->found->set_current(options[current]);
+    this->loading = false;
+    this->found_row->show();
+    // One found and none chosen yet: take it
+    if (this->found_hosts.size() == 1 && this->status.value("host").toString().isEmpty())
+        this->set_controller({{"host", this->found_hosts.first()}});
+}
