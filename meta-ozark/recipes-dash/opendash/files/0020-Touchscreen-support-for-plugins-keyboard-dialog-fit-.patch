diff --git a/src/app/widgets/touch_input.cpp b/src/app/widgets/touch_input.cpp
new file mode 100644
index 0000000..811c0f3
--- /dev/null
+++ b/src/app/widgets/touch_input.cpp
@@ -0,0 +1,108 @@
+#include <cmath>
+
+#include <QAbstractSpinBox>
+#include <QDialog>
+#include <QDoubleValidator>
+#include <QEvent>
+#include <QFormLayout>
+#include <QIntValidator>
+#include <QLabel>
+#include <QLineEdit>
+#include <QMouseEvent>
+#include <QTimer>
+
+#include "app/arbiter.hpp"
+#include "app/widgets/dialog.hpp"
+#include "app/widgets/text_entry.hpp"
+
+#include "app/widgets/touch_input.hpp"
+
+namespace {
+// The label a form shows next to a field, for the keyboard's title
+QString form_label(QWidget *field)
+{
+    for (QWidget *w = field; w && w->parentWidget(); w = w->parentWidget()) {
+        if (auto form = qobject_cast<QFormLayout *>(w->parentWidget()->layout())) {
+            if (auto label = qobject_cast<QLabel *>(form->labelForField(w)))
+                return label->text().remove('&');
+        }
+        for (QFormLayout *form : w->parentWidget()->findChildren<QFormLayout *>()) {
+            if (auto label = qobject_cast<QLabel *>(form->labelForField(w)))
+                return label->text().remove('&');
+        }
+        if (w->isWindow())
+            break;
+    }
+    return QString();
+}
+}  // namespace
+
+TouchInput::TouchInput(Arbiter &arbiter, QObject *parent)
+    : QObject(parent)
+    , arbiter(arbiter)
+{
+}
+
+bool TouchInput::eventFilter(QObject *watched, QEvent *event)
+{
+    if (event->type() == QEvent::MouseButtonRelease) {
+        auto line = qobject_cast<QLineEdit *>(watched);
+        if (line && line->isEnabled() && !line->isReadOnly() && !line->property("ozark_keyboard").toBool() &&
+            line->rect().contains(static_cast<QMouseEvent *>(event)->pos()))
+            QTimer::singleShot(0, line, [this, line] { this->edit(line); });
+    }
+    else if (event->type() == QEvent::Show) {
+        // Dash's own dialogs (and the OSD) are frameless and place themselves
+        auto dialog = qobject_cast<QDialog *>(watched);
+        if (dialog && dialog->isWindow() && !(dialog->windowFlags() & Qt::FramelessWindowHint))
+            QTimer::singleShot(0, dialog, [this, dialog] { this->fit(dialog); });
+    }
+    return QObject::eventFilter(watched, event);
+}
+
+void TouchInput::edit(QLineEdit *line)
+{
+    if (this->editing)
+        return;
+    this->editing = line;
+
+    auto spin = qobject_cast<QAbstractSpinBox *>(line->parentWidget());
+    const QValidator *validator = line->validator();
+    const bool numbers = spin || qobject_cast<const QIntValidator *>(validator) ||
+                         qobject_cast<const QDoubleValidator *>(validator) ||
+                         (line->inputMethodHints() & (Qt::ImhDigitsOnly | Qt::ImhFormattedNumbersOnly | Qt::ImhPreferNumbers));
+    QString title = form_label(spin ? static_cast<QWidget *>(spin) : line);
+    if (title.isEmpty())
+        title = line->placeholderText();
+    if (title.isEmpty())
+        title = "Enter text";
+
+    // The text box may be gone by the time "done" is tapped (its dialog closed)
+    QPointer<QLineEdit> target(line);
+    QPointer<QAbstractSpinBox> target_spin(spin);
+    Dialog *dialog = TextEntry::edit(this->arbiter, line->window(), title, line->text(), numbers, [target, target_spin](const QString &text) {
+        if (!target)
+            return;
+        QLineEdit *line = target;
+        QAbstractSpinBox *spin = target_spin;
+        line->setText(text);
+        if (spin)
+            spin->interpretText();
+        QMetaObject::invokeMethod(line, "editingFinished");
+    });
+    // The keyboard dialog deletes itself on close: the next tap may open one
+    connect(dialog, &QObject::destroyed, this, [this] { this->editing = nullptr; });
+}
+
+void TouchInput::fit(QDialog *dialog)
+{
+    QWidget *window = this->arbiter.window();
+    if (!dialog->isVisible() || !window)
+        return;
+    const int margin = std::ceil(24 * this->arbiter.layout().scale);
+    const QRect room = window->geometry().adjusted(margin, margin, -margin, -margin);
+    const QSize size = dialog->sizeHint().expandedTo(dialog->minimumSizeHint()).boundedTo(room.size());
+    QRect frame(QPoint(), size);
+    frame.moveCenter(room.center());
+    dialog->setGeometry(frame);
+}
