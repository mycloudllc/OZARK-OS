+// Six presets per band. Tap: tune to it (an empty one saves the current
+// station). Hold: save the current station there.
+QWidget *RadioPlayerTab::presets_widget()
+{
+    auto widget = new QWidget(this);
+    auto layout = new QHBoxLayout(widget);
+    layout->setContentsMargins(0, 0, 0, 0);
+
+    auto save = [this](int index) {
+        const QString key = "Pages/Media/Radio/Presets/" + this->band_key();
+        QStringList presets = this->settings.value(key).toStringList();
+        while (presets.size() < PRESETS)
+            presets << QString();
+        presets[index] = QString::number(this->tuner->value());
+        this->settings.setValue(key, presets);
+        this->update_presets();
+    };
+
+    for (int i = 0; i < PRESETS; i++) {
+        auto button = new QPushButton(widget);
+        button->setCheckable(true);
+        button->setFont(this->arbiter.forge().font(14, true));
+        button->setSizePolicy(QSizePolicy::Expanding, QSizePolicy::Fixed);
+        auto hold = new QTimer(button);
+        hold->setSingleShot(true);
+        hold->setInterval(800);
+        connect(hold, &QTimer::timeout, [save, i]{ save(i); });
+        connect(button, &QPushButton::pressed, [hold]{ hold->start(); });
+        connect(button, &QPushButton::released, [this, save, hold, i]{
+            const bool held = !hold->isActive();
+            hold->stop();
+            if (held)
+                return;
+            const int station = this->settings.value("Pages/Media/Radio/Presets/" + this->band_key()).toStringList().value(i).toInt();
+            if (station > 0)
+                this->tuner->setValue(station);
+            else
+                save(i);
+        });
+        // The checked state shows the preset that is playing, not the tap
+        connect(button, &QPushButton::clicked, [this]{ this->update_presets(); });
+        this->preset_buttons.append(button);
+        layout->addWidget(button);
+    }
 
     return widget;
 }
