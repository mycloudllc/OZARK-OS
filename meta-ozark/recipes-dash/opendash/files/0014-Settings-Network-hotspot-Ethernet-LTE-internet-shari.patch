+#include "app/arbiter.hpp"
+#include "app/config.hpp"
+#include "app/widgets/selector.hpp"
+#include "app/widgets/switch.hpp"
+#include "app/widgets/text_entry.hpp"
+
+#include "app/pages/network_settings.hpp"
+
+namespace {
+const char *kTool = "/usr/sbin/ozark-net";
+const QString kBand5 = "5 GHz";
+const QString kBand24 = "2.4 GHz";
+const QString kDhcp = "automatic (DHCP)";
+const QString kStatic = "static";
+
+QString interface_name(const QString &iface)
+{
+    if (iface.isEmpty())
+        return "none";
+    if (iface.startsWith("eth") || iface.startsWith("en"))
+        return "Ethernet";
+    if (iface.startsWith("wwan") || iface.startsWith("ww"))
+        return "LTE";
+    if (iface.startsWith("wl"))
+        return "Wi-Fi";
+    return iface;
+}
+}  // namespace
+
+NetworkSettingsTab::NetworkSettingsTab(Arbiter &arbiter, QWidget *parent)
+    : QWidget(parent)
+    , arbiter(arbiter)
+    , timer(new QTimer(this))
+{
+    auto layout = new QVBoxLayout(this);
+    layout->setContentsMargins(6, 0, 6, 0);
+
+    auto scroll = new QScrollArea(this);
+    Session::Forge::to_touch_scroller(scroll);
+    scroll->setWidgetResizable(true);
+    scroll->setWidget(this->settings_widget());
+    layout->addWidget(scroll);
+
+    // Status (connections, signal) refreshes while the tab is on screen
+    this->timer->setInterval(3000);
+    connect(this->timer, &QTimer::timeout, [this] { this->refresh(); });
+}
+
+void NetworkSettingsTab::showEvent(QShowEvent *event)
+{
+    QWidget::showEvent(event);
+    this->refresh();
+    this->timer->start();
+}
+
+void NetworkSettingsTab::hideEvent(QHideEvent *event)
+{
+    QWidget::hideEvent(event);
+    this->timer->stop();
+}
+
+QWidget *NetworkSettingsTab::row(const QString &label, QWidget *control, bool stretch)
+{
+    auto widget = new QWidget(this);
+    auto layout = new QHBoxLayout(widget);
+    layout->addWidget(new QLabel(label, widget), 1);
+    if (stretch)
+        layout->addWidget(control, 1);
+    else
+        layout->addWidget(control, 1, Qt::AlignHCenter);
+    return widget;
+}
+
+QLabel *NetworkSettingsTab::heading(const QString &text)
+{
+    auto label = new QLabel(text, this);
+    QFont font(label->font());
+    font.setBold(true);
+    label->setFont(font);
+    return label;
+}
+
+QPushButton *NetworkSettingsTab::apply_button(const QString &text, std::function<void()> apply)
+{
+    auto button = new QPushButton(text, this);
+    button->setFont(this->arbiter.forge().font(14));
+    connect(button, &QPushButton::clicked, apply);
+    this->buttons.append(button);
+    return button;
+}
+
+QWidget *NetworkSettingsTab::settings_widget()
+{
+    const QFont font14 = this->arbiter.forge().font(14);
+    const QFont font11 = this->arbiter.forge().font(11);
+    const double scale = this->arbiter.layout().scale;
+
+    auto widget = new QWidget(this);
+    auto layout = new QVBoxLayout(widget);
+
+    this->internet = new QLabel(widget);
+    layout->addWidget(this->row("Internet", this->internet));
+    this->result = new QLabel(widget);
+    this->result->setWordWrap(true);
+    this->result->setFont(font11);
+    this->result->hide();
+    layout->addWidget(this->result);
+
+    // Hotspot
+    layout->addWidget(Session::Forge::br());
+    layout->addWidget(this->heading("Hotspot"));
+    this->hotspot_state = new QLabel(widget);
+    layout->addWidget(this->row("Status", this->hotspot_state));
+    this->ssid = new TextEntry(this->arbiter, "Hotspot name", TextEntry::Text, widget);
+    layout->addWidget(this->row("Name", this->ssid, true));
+    this->password = new TextEntry(this->arbiter, "Hotspot password", TextEntry::Password, widget);
+    layout->addWidget(this->row("Password", this->password, true));
+    this->band = new Selector({kBand5, kBand24}, kBand5, font14, this->arbiter, widget);
+    layout->addWidget(this->row("Band", this->band));
+    this->country = new TextEntry(this->arbiter, "Country code (two letters, e.g. US)", TextEntry::Text, widget);
+    layout->addWidget(this->row("Country", this->country, true));
+    layout->addWidget(this->apply_button("apply hotspot settings", [this] { this->apply_hotspot(); }), 0, Qt::AlignRight);
+
+    this->share = new Switch(widget);
+    this->share->scale(scale);
+    connect(this->share, &Switch::stateChanged, [this](bool on) {
+        if (this->loading)
+            return;
+        this->set_busy(true);
+        this->run({"share", on ? "yes" : "no"}, [this, on](bool ok, const QString &message) {
+            this->set_busy(false);
+            this->report(ok, ok ? (on ? "Sharing the internet on the hotspot." : "Stopped sharing the internet.") : message);
+            this->refresh();
+        });
+    });
+    layout->addWidget(this->row("Share internet", this->share));
+    auto hint = new QLabel("Android Auto phones get a new name and password automatically. "
+                           "Sharing gives devices on the hotspot the radio's internet (Ethernet or LTE).", widget);
+    hint->setWordWrap(true);
+    hint->setFont(font11);
+    layout->addWidget(hint);
+
+    // Ethernet
+    layout->addWidget(Session::Forge::br());
+    layout->addWidget(this->heading("Ethernet"));
+    this->ethernet_state = new QLabel(widget);
+    layout->addWidget(this->row("Status", this->ethernet_state));
+    this->ethernet_mode = new Selector({kDhcp, kStatic}, kDhcp, font14, this->arbiter, widget);
+    layout->addWidget(this->row("Address", this->ethernet_mode));
+    this->static_rows = new QWidget(widget);
+    auto static_layout = new QVBoxLayout(this->static_rows);
+    static_layout->setContentsMargins(0, 0, 0, 0);
+    this->ethernet_address = new TextEntry(this->arbiter, "IP address / prefix", TextEntry::Number, this->static_rows);
+    this->ethernet_address->set_placeholder("e.g. 192.168.1.50/24");
+    static_layout->addWidget(this->row("IP address", this->ethernet_address, true));
+    this->ethernet_gateway = new TextEntry(this->arbiter, "Gateway", TextEntry::Number, this->static_rows);
+    this->ethernet_gateway->set_placeholder("e.g. 192.168.1.1");
+    static_layout->addWidget(this->row("Gateway", this->ethernet_gateway, true));
+    this->ethernet_dns = new TextEntry(this->arbiter, "DNS server", TextEntry::Number, this->static_rows);
+    this->ethernet_dns->set_placeholder("optional");
+    static_layout->addWidget(this->row("DNS server", this->ethernet_dns, true));
+    layout->addWidget(this->static_rows);
+    connect(this->ethernet_mode, &Selector::item_changed, [this](QString mode) {
+        this->static_rows->setVisible(mode == kStatic);
+    });
+    this->static_rows->hide();
+    layout->addWidget(this->apply_button("apply ethernet settings", [this] { this->apply_ethernet(); }), 0, Qt::AlignRight);
+
+    // LTE
+    layout->addWidget(Session::Forge::br());
+    layout->addWidget(this->heading("LTE"));
+    this->lte_state = new QLabel(widget);
+    this->lte_state->setWordWrap(true);
+    layout->addWidget(this->row("Status", this->lte_state, true));
+    this->lte_enabled = new Switch(widget);
+    this->lte_enabled->scale(scale);
+    layout->addWidget(this->row("Use LTE", this->lte_enabled));
+    this->apn = new TextEntry(this->arbiter, "APN (from your carrier)", TextEntry::Text, widget);
+    this->apn->set_placeholder("carrier default");
+    layout->addWidget(this->row("APN", this->apn, true));
+    this->pin = new TextEntry(this->arbiter, "SIM PIN", TextEntry::Password, widget);
+    this->pin->set_placeholder("none");
+    layout->addWidget(this->row("SIM PIN", this->pin, true));
+    layout->addWidget(this->apply_button("apply LTE settings", [this] { this->apply_lte(); }), 0, Qt::AlignRight);
+
+    layout->addStretch();
+    return widget;
+}
+
+void NetworkSettingsTab::run(const QStringList &args, std::function<void(bool, const QString &)> done)
+{
+    auto process = new QProcess(this);
+    connect(process, QOverload<int, QProcess::ExitStatus>::of(&QProcess::finished),
+            [process, done](int code, QProcess::ExitStatus exit_status) {
+        const QString err = QString::fromUtf8(process->readAllStandardError()).trimmed().split('\n').last();
+        const bool ok = exit_status == QProcess::NormalExit && code == 0;
+        done(ok, ok ? QString() : (err.isEmpty() ? QString("Failed (exit code %1)").arg(code) : err));
+        process->deleteLater();
+    });
+    connect(process, &QProcess::errorOccurred, [process, done](QProcess::ProcessError error) {
+        if (error == QProcess::FailedToStart) {
+            done(false, "Network settings are not available on this system.");
+            process->deleteLater();
+        }
+    });
+    process->start(kTool, args);
+}
+
+void NetworkSettingsTab::refresh()
+{
+    auto process = new QProcess(this);
+    connect(process, QOverload<int, QProcess::ExitStatus>::of(&QProcess::finished), [this, process](int, QProcess::ExitStatus) {
+        QMap<QString, QString> status;
+        for (const QString &line : QString::fromUtf8(process->readAllStandardOutput()).split('\n')) {
+            const int eq = line.indexOf('=');
+            if (eq > 0)
+                status[line.left(eq)] = line.mid(eq + 1);
+        }
+        process->deleteLater();
+        this->show_status(status);
+        if (!this->filled && !this->busy) {
+            this->fill_fields(status);
+            this->filled = true;
+        }
+    });
+    connect(process, &QProcess::errorOccurred, [this, process](QProcess::ProcessError error) {
+        if (error == QProcess::FailedToStart) {
+            this->internet->setText("unknown");
+            this->report(false, "Network settings are not available on this system.");
+            for (auto button : this->buttons)
+                button->setEnabled(false);
+            this->timer->stop();
+            process->deleteLater();
+        }
+    });
+    process->start(kTool, {"status"});
+}
+
+void NetworkSettingsTab::show_status(const QMap<QString, QString> &s)
+{
+    this->internet->setText(QString("via %1").arg(interface_name(s.value("internet.via"))));
+
+    if (s.value("hotspot.running") == "active") {
+        const int clients = s.value("hotspot.clients").toInt();
+        this->hotspot_state->setText(QString("on, %1 %2 connected%3")
+            .arg(clients).arg(clients == 1 ? "device" : "devices")
+            .arg(s.value("hotspot.share") == "yes" ? ", sharing internet" : ""));
+    }
+    else {
+        this->hotspot_state->setText("off");
+    }
+
+    const QString link = s.value("ethernet.link");
+    if (link == "none")
+        this->ethernet_state->setText("no Ethernet port");
+    else if (link == "down")
+        this->ethernet_state->setText("no cable");
+    else if (s.value("ethernet.address").isEmpty())
+        this->ethernet_state->setText("connected, waiting for an address");
+    else
+        this->ethernet_state->setText(QString("connected, %1").arg(s.value("ethernet.address")));
+
+    QStringList lte;
+    if (s.value("lte.modem").trimmed().isEmpty() && s.value("lte.state") != "off") {
+        lte << "no modem found";
+    }
+    else {
+        lte << s.value("lte.message", "off").toLower();
+        if (!s.value("lte.operator").isEmpty())
+            lte << s.value("lte.operator");
+        if (!s.value("lte.technology").isEmpty())
+            lte << s.value("lte.technology").toUpper();
+        if (!s.value("lte.signal").isEmpty())
+            lte << QString("signal %1%").arg(s.value("lte.signal"));
+        if (!s.value("lte.address").isEmpty())
+            lte << s.value("lte.address");
+    }
+    this->lte_state->setText(lte.join(", "));
+}
+
+void NetworkSettingsTab::fill_fields(const QMap<QString, QString> &s)
+{
+    this->loading = true;
+    this->ssid->set_value(s.value("hotspot.ssid"));
+    this->password->set_value(s.value("hotspot.password"));
+    this->channel = s.value("hotspot.channel", "36");
+    this->band->set_current(this->channel.toInt() > 14 ? kBand5 : kBand24);
+    this->country->set_value(s.value("hotspot.country", "US"));
+    this->share->setChecked(s.value("hotspot.share") == "yes");
+
+    const bool fixed = s.value("ethernet.mode") == "static";
+    this->ethernet_mode->set_current(fixed ? kStatic : kDhcp);
+    this->static_rows->setVisible(fixed);
+    this->ethernet_address->set_value(s.value("ethernet.static_address"));
+    this->ethernet_gateway->set_value(s.value("ethernet.static_gateway"));
+    this->ethernet_dns->set_value(s.value("ethernet.static_dns"));
+
+    this->lte_enabled->setChecked(s.value("lte.enabled") == "yes");
+    this->apn->set_value(s.value("lte.apn"));
+    this->pin->set_value(s.value("lte.pin"));
+    this->loading = false;
+}
+
+void NetworkSettingsTab::set_busy(bool busy)
+{
+    this->busy = busy;
+    for (auto button : this->buttons)
+        button->setEnabled(!busy);
+    if (busy)
+        this->report(true, "Applying...");
+}
+
+void NetworkSettingsTab::report(bool ok, const QString &message)
+{
+    this->result->setText(message);
+    this->result->setStyleSheet(ok ? QString() : QString("color: rgb(211, 47, 47);"));
+    this->result->setVisible(!message.isEmpty());
+}
+
+void NetworkSettingsTab::apply_hotspot()
+{
+    const QString ssid = this->ssid->value();
+    const QString password = this->password->value();
+    // Keep a 5 GHz channel other than 36 (e.g. 149) if the band didn't change
+    QString channel = (this->band->get_current() == kBand5) ? "36" : "6";
+    if ((this->channel.toInt() > 14) == (channel.toInt() > 14))
+        channel = this->channel;
+    this->set_busy(true);
+    this->run({"hotspot", ssid, password, channel, this->country->value().toUpper()},
+              [this, ssid, password, channel](bool ok, const QString &message) {
+        this->set_busy(false);
+        if (ok) {
+            this->channel = channel;
+            // OpenAuto sends these to the phone; it read them at startup
+            auto config = Config::get_instance()->openauto_config;
+            config->setWifiSSID(ssid.toStdString());
+            config->setWifiPassword(password.toStdString());
+        }
+        this->report(ok, ok ? "Hotspot updated." : message);
+        this->refresh();
+    });
+}
+
+void NetworkSettingsTab::apply_ethernet()
+{
+    QStringList args{"ethernet"};
+    if (this->ethernet_mode->get_current() == kStatic) {
+        args << "static" << this->ethernet_address->value() << this->ethernet_gateway->value();
+        if (!this->ethernet_dns->value().isEmpty())
+            args << this->ethernet_dns->value();
+    }
+    else {
+        args << "dhcp";
+    }
+    this->set_busy(true);
+    this->run(args, [this](bool ok, const QString &message) {
+        this->set_busy(false);
+        this->report(ok, ok ? "Ethernet updated." : message);
+        this->refresh();
+    });
+}
+
+void NetworkSettingsTab::apply_lte()
+{
+    this->set_busy(true);
+    this->run({"lte", this->lte_enabled->isChecked() ? "yes" : "no", this->apn->value(), this->pin->value()},
+              [this](bool ok, const QString &message) {
+        this->set_busy(false);
+        this->report(ok, ok ? "LTE updated." : message);
+        this->refresh();
+    });
+}
