+// Each band keeps its own station and presets
+void RadioPlayerTab::set_band(Tuner::Band band)
+{
+    const bool am = band == Tuner::Band::AM;
+    this->tuner->blockSignals(true);
+    this->tuner->set_band(band);
+    this->tuner->setValue(am ? this->settings.value("Pages/Media/Radio/am_station", 101).toInt()
+                             : int(this->config->get_radio_station()));
+    this->tuner->blockSignals(false);
+    this->fm_button->setChecked(!am);
+    this->am_button->setChecked(am);
+    this->unit->setText(am ? "kHz" : "MHz");
+    this->settings.setValue("Pages/Media/Radio/band", am ? "am" : "fm");
+    if (RadioPlugin *plugin = qobject_cast<RadioPlugin *>(this->loader.instance())) {
+        plugin->am(am);
+        plugin->freq(this->tuner->hz());
+    }
+    emit this->tuner->valueChanged(this->tuner->value());
+}
+
+void RadioPlayerTab::update_presets()
+{
+    const QStringList presets = this->settings.value("Pages/Media/Radio/Presets/" + this->band_key()).toStringList();
+    for (int i = 0; i < this->preset_buttons.size(); i++) {
+        const int station = presets.value(i).toInt();
+        QPushButton *button = this->preset_buttons[i];
+        button->setText(station > 0 ? this->tuner->label(station) : QString("+"));
+        button->setChecked(station > 0 && station == this->tuner->value());
+    }
 }
 
